---
// Italian translation of src/pages/fr/consultation/a-domicile.astro (October 2026).
// When the French page changes, update this one too.
import Layout from '../../../layouts/Layout.astro';
import { HOME_VISIT_FORM, WHATSAPP_URL, isFormConfigured, toEmbedUrl } from '../../../data/booking';

const formUrl = HOME_VISIT_FORM.it;
const configured = isFormConfigured(formUrl);
const embedUrl = toEmbedUrl(formUrl);
---

<Layout title="Consulenza a domicilio | Ariadna Balsells" lang="it"
  description="Richiesta di seduta di logopedia a domicilio a Bruxelles. Compilate il modulo online e vi ricontatterò.">

  <section class="page-hero soft-band soft-band-top grain">
    <div class="container">
      <p class="section-label">Consulenza</p>
      <h1>A domicilio</h1>

      {/* ⚠️ TEXTE PROVISOIRE : À RÉDIGER PAR ARI.
          Doit préciser : zone géographique couverte, dans quels cas le domicile
          est indiqué, délai de réponse habituel, et tarif / frais de déplacement. */}
      <p class="tagline">
        In alcune situazioni è più utile lavorare direttamente nell'ambiente
        quotidiano del bambino. Le sedute a domicilio si svolgono su richiesta e in base
        alla mia disponibilità.
      </p>
      <p class="tagline">
        Compilate il modulo qui sotto: vi ricontatterò per confermare se un
        accompagnamento a domicilio è possibile e per fissare un orario.
      </p>
    </div>
  </section>

  <section class="form-section reveal">
    <div class="container">

      {configured ? (
        <div class="form-embed">
          <iframe
            title="Modulo di richiesta di seduta a domicilio"
            data-consent-src={embedUrl}
            width="100%"
            height="100%"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            loading="lazy">
          </iframe>
          <div class="consent-placeholder form-placeholder">
            <p>
              Questo modulo è ospitato da Google. Resta nascosto finché i cookie
              non vengono accettati.
            </p>
            <button type="button" class="consent-btn" onclick="window.openCookieSettings && window.openCookieSettings()">
              Accetta i cookie
            </button>
            <a href={formUrl} target="_blank" rel="noopener">
              Oppure apri il modulo in una nuova scheda
            </a>
          </div>
        </div>
      ) : (
        <div class="form-missing">
          <p>
            Il modulo di richiesta online sarà disponibile a breve. Nel frattempo,
            scrivetemi direttamente su WhatsApp. È la soluzione più rapida.
          </p>
          <a href={WHATSAPP_URL} class="btn-whatsapp" target="_blank" rel="noopener">
            Scrivi su WhatsApp
          </a>
        </div>
      )}

      <div class="after-form">
        <p>
          Avete una domanda prima di inviare la richiesta? Il modo più rapido resta
          <a href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>.
          Lì rispondo molto più velocemente che al telefono.
        </p>
        <p class="small">
          Per una seduta in studio, la prenotazione si fa direttamente online:
          <a href="/it/consulenza/in-studio/">vedi le sedute in studio</a>.
        </p>
      </div>

    </div>
  </section>

</Layout>

<style>
  /* Until the request form exists, the fallback message IS the page, so it
     gets the same card treatment as every other primary block on the site
     rather than sitting as loose text on the ground. */
  .form-missing,
  .after-form {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 2rem;
    max-width: 1100px;
    margin: 0 auto 1.5rem;
  }
  .form-embed {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .page-hero { padding: 5rem 0 2.5rem; }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.8rem;
  }
  .tagline {
    color: var(--color-text-light);
    font-size: 1rem;
    max-width: 640px;
    line-height: 1.75;
    margin-bottom: 0.9rem;
  }

  /* ── Embedded Google Form ── */
  .form-section { padding: 1rem 0 4rem; }

  .form-embed {
    position: relative;
    /* Tune once the real form is embedded: too short and it scrolls
       inside the frame, too tall and you get empty space below. */
    height: 1500px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
  }
  .form-embed iframe {
    display: block;
    border: 0;
    width: 100%;
    height: 100%;
  }

  .form-placeholder {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
    padding: 2rem;
  }
  .form-placeholder p {
    font-size: 0.92rem;
    color: var(--color-text-light);
    margin: 0;
    max-width: 340px;
    line-height: 1.65;
  }
  .form-placeholder a {
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Shown only while the form URL has not been pasted into booking.ts */
  .form-missing {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 2.5rem;
    text-align: center;
  }
  .form-missing p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── After the form ── */
  .after-form {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .after-form p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.7;
  }
  .after-form .small {
    font-size: 0.83rem;
    margin-top: 0.6rem;
  }
  .after-form a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .container { padding: 0 1.25rem; }
    .page-hero { padding: 3.5rem 0 1.5rem; }
    .form-embed { height: 1750px; }
    .form-missing { padding: 1.75rem; }
  }
</style>

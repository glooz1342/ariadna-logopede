---
import Layout from '../../../layouts/Layout.astro';
import { ROSA_URL, WHATSAPP_URL } from '../../../data/booking';

// ⚠️ À FAIRE VALIDER PAR ARI : textes des étapes et des boutons par domaine,
// fréquence des séances, compte rendu écrit, bloc « Bon à savoir ».

// Ligne du temps : ici l'ordre compte, d'où la numérotation.
// Sous chaque étape, un bouton par domaine déplie le détail propre à ce suivi.
const domains = [
  {
    "key": "langage",
    "label": "Langage oral"
  },
  {
    "key": "tap",
    "label": "Alimentation"
  },
  {
    "key": "maths",
    "label": "Cognition mathématique"
  }
] as const;

const steps = [
  {
    "title": "Le premier rendez-vous",
    "text": "Nous prenons le temps de parler de votre enfant : son développement, son quotidien, ce qui vous questionne et ce que vous avez déjà observé. Nous discutons aussi de vos préoccupations et de ce qui vous amène à consulter.",
    "loop": false,
    "details": null,
    "notice": "Dans certains cas, il est possible d'introduire auprès de votre mutuelle une demande d'accord pour le remboursement. Pour cela, une prescription médicale pour un bilan logopédique est nécessaire. Pensez à la demander à votre médecin avant le premier rendez-vous."
  },
  {
    "title": "Le bilan",
    "text": "Le bilan se fait sur une ou plusieurs séances. Lorsque c'est possible, j'utilise des épreuves standardisées afin d'objectiver les observations. J'évalue aussi votre enfant de façon qualitative, en observant comment il s'y prend dans différentes situations. Le bilan est construit en fonction de votre demande, pour comprendre précisément comment fonctionne votre enfant : ses forces et ses fragilités.",
    "loop": false,
    "details": {
      "langage": "J'évalue le langage (vocabulaire, construction des phrases, sons de la langue, compréhension), la parole et la communication : la façon dont votre enfant entre en relation, se fait comprendre et raconte. Quand votre enfant grandit avec plusieurs langues, j'en tiens compte dans l'évaluation.",
      "tap": "J'observe un repas, idéalement avec des aliments que votre enfant accepte et d'autres plus difficiles pour lui. J'évalue ses compétences pour manger et boire : mastication, déglutition, gestion des textures, comportement face à la nourriture.",
      "maths": "J'évalue les bases du nombre (perception des quantités, comptage, lien entre les chiffres, les mots et les quantités), le calcul et la résolution de problèmes. Je situe ensuite les résultats par rapport à ce qui est attendu à son niveau scolaire."
    },
    "notice": null
  },
  {
    "title": "Les objectifs",
    "text": "À la suite du bilan, nous nous mettons d'accord sur les objectifs. Nous fixons ensemble des objectifs concrets, qui ont du sens pour votre enfant et pour vous.",
    "loop": false,
    "details": {
      "langage": "Un objectif peut être, par exemple, de se faire comprendre par ses camarades en classe ou de demander de l'aide avec un mot, un geste ou un pictogramme.",
      "tap": "Un objectif peut être, par exemple, de goûter une nouvelle texture ou de prendre le repas à table avec le reste de la famille. Quand la croissance est en jeu, les objectifs se décident aussi avec le médecin.",
      "maths": "Un objectif peut être, par exemple, de comparer deux quantités sans compter un à un ou de comprendre ce que représente une soustraction dans un problème."
    },
    "notice": null
  },
  {
    "title": "Le suivi",
    "text": "Le suivi commence ensuite, à la fréquence conseillée au moment de fixer les objectifs. Je tiens à le souligner : votre présence dans le suivi est importante. Pour certains types de prise en charge, il vous sera même demandé d'assister aux séances.",
    "loop": false,
    "details": {
      "langage": "Les séances s'appuient sur le jeu et sur des situations de communication réelles. Quand c'est utile, j'introduis la communication alternative et augmentée (CAA) : pictogrammes, gestes ou outil numérique. La CAA soutient le développement du langage oral et donne à votre enfant un moyen de s'exprimer dès maintenant.",
      "tap": "Les troubles alimentaires pédiatriques touchent plusieurs dimensions à la fois : médicale, nutritionnelle, compétences alimentaires et vécu familial. Je travaille donc en lien avec le médecin de votre enfant et les autres professionnels qui le suivent. Les nouvelles textures et les nouveaux aliments sont introduits progressivement. Une grande partie du travail se fait avec vous, autour des repas à la maison.",
      "maths": "Le travail vise la compréhension avant l'automatisation, avec du matériel concret et des représentations visuelles. Quand c'est possible, je reste en contact avec l'école pour que nos séances soutiennent ce qui se fait en classe."
    },
    "notice": null
  },
  {
    "title": "Faire le point",
    "text": "À intervalles réguliers, nous regardons ensemble le chemin parcouru. Quand les objectifs sont atteints, nous en fixons de nouveaux ou nous clôturons le suivi.",
    "loop": true,
    "details": {
      "langage": "Je repasse certaines épreuves du bilan pour mesurer l'évolution. Nous regardons aussi ce qui a changé dans la communication au quotidien, à la maison et à l'école.",
      "tap": "Nous regardons l'évolution des aliments acceptés, du déroulement des repas à la maison et, avec le médecin, de la croissance.",
      "maths": "Je repasse certaines épreuves du bilan et nous croisons les résultats avec ce que l'école observe en classe."
    },
    "notice": null
  }
];
---

<Layout title="Consultation en cabinet | Ariadna Balsells" lang="fr"
  description="Consultations de logopédie au CAP'S à Woluwe-Saint-Lambert : premier rendez-vous, bilan, objectifs et suivi en langage oral, alimentation (TAP) et cognition mathématique.">

  <section class="page-hero soft-band soft-band-top grain">
    <div class="container">
      <p class="eyebrow section-label">Consultation</p>
      <h1>En cabinet</h1>
      <p class="tagline">
        Les consultations se déroulent au CAP'S, à Woluwe-Saint-Lambert, dans un espace
        pensé pour les enfants et leur famille.
      </p>
      <a href={ROSA_URL.fr} class="btn-primary" target="_blank" rel="noopener">Prendre rendez-vous en ligne</a>
    </div>
  </section>

  <section class="journey reveal soft-band band-on-ground">
    <div class="container">
      <p class="section-label">Le déroulement</p>
      <h2>Comment se passe un accompagnement</h2>
      <p class="journey-intro">Sous les étapes, cliquez sur un domaine pour voir ce qu'elles recouvrent dans votre situation.</p>

      <ol class="timeline">
        {steps.map((s, i) => (
          <li class:list={['step', { 'step-loop': s.loop }]}>
            <span class="step-marker" aria-hidden="true"></span>
            <div class="step-body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              {s.notice && (
                <p class="notice"><strong>Remboursement.</strong> {s.notice}</p>
              )}
              {s.details && (<>
              <div class="pills" role="group" aria-label={s.title}>
                {domains.map(d => (
                  <button type="button" class="pill" aria-expanded="false"
                    aria-controls={`step${i + 1}-${d.key}`}>{d.label}</button>
                ))}
              </div>
              {domains.map(d => (
                <div class="pill-panel" id={`step${i + 1}-${d.key}`} data-pill-panel>
                  <span class="pill-panel-label">{d.label}</span>
                  <p>{s.details[d.key]}</p>
                </div>
              ))}
              </>)}
            </div>
          </li>
        ))}
      </ol>

      <p class="helper">Vous ne savez pas par où commencer ? Réservez un premier rendez-vous : nous ferons le point ensemble.</p>
    </div>
  </section>

  <section class="practical reveal">
    <div class="container practical-grid">
      <div class="practical-block">
        <h3>Où ?</h3>
        <p>
          CAP'S, Centre d'Accompagnement Pédiatrique Spécialisé<br />
          Pl. de la Sainte-Famille 23<br />
          1200 Woluwe-Saint-Lambert
        </p>
      </div>
      <div class="practical-block">
        <h3>Bon à savoir</h3>
        <ul>
          <li>Apportez les documents utiles au premier rendez-vous : rapports scolaires, bilans précédents, courriers médicaux.</li>
          <li>
            Pour connaître les tarifs, <a href={WHATSAPP_URL} target="_blank" rel="noopener">écrivez-moi</a> :
            je vous les envoie par message.
          </li>
          <li>En cas d'empêchement, prévenez-moi au plus tôt afin de libérer le créneau.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cta reveal">
    <div class="container">
      <h2>Réserver un créneau</h2>
      <p>
        Mes rendez-vous se prennent en ligne via Rosa, ma plateforme de réservation.
        Vous y voyez mes disponibilités en temps réel.
      </p>
      <a href={ROSA_URL.fr} class="btn-primary" target="_blank" rel="noopener">Prendre rendez-vous en ligne</a>
      <p class="cta-alt">
        Vous préférez une consultation à domicile ?
        <a href="/fr/consultation/a-domicile/">Remplissez le formulaire de demande</a>.
      </p>
    </div>
  </section>

</Layout>


<script>
  // Panels stay visible without JS; with JS they start closed and each
  // step's buttons work as a small toggle group (one panel open at a time).
  document.querySelectorAll<HTMLElement>('[data-pill-panel]').forEach(p => (p.hidden = true));
  document.querySelectorAll<HTMLElement>('.step-body').forEach(step => {
    const pills = step.querySelectorAll<HTMLButtonElement>('.pill');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const open = pill.getAttribute('aria-expanded') === 'true';
        pills.forEach(other => {
          other.setAttribute('aria-expanded', 'false');
          const panel = document.getElementById(other.getAttribute('aria-controls')!);
          if (panel) panel.hidden = true;
        });
        if (!open) {
          pill.setAttribute('aria-expanded', 'true');
          const panel = document.getElementById(pill.getAttribute('aria-controls')!);
          if (panel) panel.hidden = false;
        }
      });
    });
  });
</script>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── Hero ── */
  .page-hero { padding: 5rem 0 3rem; }
  .page-hero .btn-primary { margin-top: 1.25rem; }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.6rem;
  }
  .tagline {
    color: var(--color-text-light);
    font-size: 1.05rem;
    max-width: 620px;
    line-height: 1.7;
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 2.5rem;
  }

  /* ── Timeline ── */
  .journey {
    background: white;
    padding: 4.5rem 0;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 760px;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    gap: 1.25rem;
    padding-bottom: 2.25rem;
  }
  /* Connecting line between markers */
  .step::before {
    content: '';
    position: absolute;
    left: calc(0.55rem - 1px);
    top: 1.9rem;
    bottom: 0;
    width: 2px;
    background: var(--color-tint-lavender);
  }
  .step:last-child { padding-bottom: 0; }
  .step:last-child::before { display: none; }

  .step-marker {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.65rem;
    border-radius: 50%;
    background: var(--color-purple);
    box-shadow: 0 0 0 5px var(--color-tint-lavender);
    position: relative;
    z-index: 1;
  }
  .notice {
    margin-top: 1rem !important;
    padding: 0.9rem 1.15rem;
    border-left: 3px solid var(--color-pink-dark);
    background: #FBF1F2;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.9rem !important;
    color: var(--color-text) !important;
  }
  .notice strong { color: var(--color-pink-dark); }

  .step-loop .step-marker {
    background: var(--color-pink);
    box-shadow: 0 0 0 5px #F3DDE0;
  }
  .step-body h3 {
    font-size: 1.1rem;
    margin: 0.55rem 0 0.5rem;
  }
  .step-body p {
    font-size: 0.95rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin: 0;
  }

  .journey h2 { margin-bottom: 0.75rem; }
  .journey-intro {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin-bottom: 2.5rem;
  }

  .helper {
    margin-top: 2.5rem;
    font-size: 0.92rem;
    color: var(--color-text-light);
    font-style: italic;
  }

  /* ── Domain pills under each step ── */
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .pill {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-tint-lavender);
    background: white;
    color: var(--color-purple-dark);
    cursor: pointer;
    transition: background 180ms, color 180ms, border-color 180ms;
  }
  .pill:hover { border-color: var(--color-purple); }
  .pill[aria-expanded='true'] {
    background: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
  }
  .pill:focus-visible {
    outline: 2px solid var(--color-purple);
    outline-offset: 2px;
  }
  .pill-panel {
    margin-top: 0.85rem;
    padding: 1.1rem 1.35rem;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }
  .pill-panel p {
    font-size: 0.9rem;
    margin: 0;
  }
  .pill-panel .pill-panel-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-purple-dark);
    margin-bottom: 0.4rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .pill { transition: none; }
  }

  /* ── Practical ── */
  .practical {
    padding: 4.5rem 0;
  }
  .practical-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2.5rem;
  }
  .practical-block h3 {
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .practical-block p,
  .practical-block li {
    font-size: 0.92rem;
    color: var(--color-text-light);
    line-height: 1.75;
  }
  .practical-block ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .practical-block li {
    position: relative;
    padding-left: 1.2rem;
  }
  .practical-block li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-purple);
  }
  .practical-block a {
    color: var(--color-purple-dark);
    text-decoration: underline;
  }

  /* ── CTA ── */
  .cta {
    padding: 4rem 0 5rem;
    text-align: center;
  }
  .cta h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.75rem;
  }
  .cta p {
    color: var(--color-text-light);
    max-width: 520px;
    margin: 0 auto 2rem;
    font-size: 0.95rem;
  }
  .cta-alt {
    margin-top: 1.5rem !important;
    font-size: 0.88rem !important;
  }
  .cta-alt a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .container { padding: 0 1.25rem; }
    .page-hero { padding: 3.5rem 0 2rem; }
    .practical-grid { grid-template-columns: 1fr; }
  }
</style>

---
import Layout from '../../../layouts/Layout.astro';
import { HOME_VISIT_FORM, WHATSAPP_NUMBER, isFormConfigured, toEmbedUrl } from '../../../data/booking';

const formUrl = HOME_VISIT_FORM.fr;
const configured = isFormConfigured(formUrl);
const embedUrl = toEmbedUrl(formUrl);
---

<Layout title="Consultation à domicile | Ariadna Balsells" lang="fr"
  description="Demande de consultation logopédique à domicile à Bruxelles. Remplissez le formulaire en ligne et je reviens vers vous.">

  <section class="page-hero soft-band soft-band-top grain">
    <div class="container">
      <p class="section-label">Consultation</p>
      <h1>À domicile</h1>

      {/* ⚠️ TEXTE PROVISOIRE : À RÉDIGER PAR ARI.
          Doit préciser : zone géographique couverte, dans quels cas le domicile
          est indiqué, délai de réponse habituel, et tarif / frais de déplacement. */}
      <p class="tagline">
        Dans certaines situations, il est plus pertinent de travailler directement
        dans l'environnement quotidien de l'enfant. Les consultations à domicile se
        font sur demande et selon mes disponibilités.
      </p>
      <p class="tagline">
        Remplissez le formulaire ci-dessous : je reviens vers vous pour confirmer
        si un accompagnement à domicile est possible et convenir d'un créneau.
      </p>
    </div>
  </section>

  <section class="form-section reveal">
    <div class="container">

      {configured ? (
        <div class="form-embed">
          <iframe
            title="Formulaire de demande de consultation à domicile"
            data-consent-src={embedUrl}
            width="100%"
            height="100%"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            loading="lazy">
          </iframe>
          <div class="consent-placeholder form-placeholder">
            <p>
              Ce formulaire est hébergé par Google. Il reste masqué tant que les cookies
              ne sont pas acceptés.
            </p>
            <button type="button" class="consent-btn" onclick="window.openCookieSettings && window.openCookieSettings()">
              Accepter les cookies
            </button>
            <a href={formUrl} target="_blank" rel="noopener">
              Ou ouvrir le formulaire dans un nouvel onglet
            </a>
          </div>
        </div>
      ) : (
        <div class="form-missing">
          <p>
            Le formulaire de demande en ligne arrive très prochainement. En attendant,
            écrivez-moi directement sur WhatsApp. C'est le plus rapide.
          </p>
          <a href={`https://wa.me/${WHATSAPP_NUMBER}`} class="btn-whatsapp" target="_blank" rel="noopener">
            Écrire sur WhatsApp
          </a>
        </div>
      )}

      <div class="after-form">
        <p>
          Une question avant d'envoyer votre demande ? Le plus rapide reste
          <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener">WhatsApp</a>.
          J'y réponds bien plus vite que par téléphone.
        </p>
        <p class="small">
          Pour une consultation au cabinet, la réservation se fait directement en ligne :
          <a href="/fr/consultation/en-cabinet/">voir les consultations en cabinet</a>.
        </p>
      </div>

    </div>
  </section>

</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .page-hero { padding: 5rem 0 2.5rem; }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.8rem;
  }
  .tagline {
    color: var(--color-text-light);
    font-size: 1rem;
    max-width: 640px;
    line-height: 1.75;
    margin-bottom: 0.9rem;
  }

  /* ── Embedded Google Form ── */
  .form-section { padding: 1rem 0 4rem; }

  .form-embed {
    position: relative;
    /* Tune once the real form is embedded: too short and it scrolls
       inside the frame, too tall and you get empty space below. */
    height: 1500px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
  }
  .form-embed iframe {
    display: block;
    border: 0;
    width: 100%;
    height: 100%;
  }

  .form-placeholder {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
    padding: 2rem;
  }
  .form-placeholder p {
    font-size: 0.92rem;
    color: var(--color-text-light);
    margin: 0;
    max-width: 340px;
    line-height: 1.65;
  }
  .form-placeholder a {
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Shown only while the form URL has not been pasted into booking.ts */
  .form-missing {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 2.5rem;
    text-align: center;
  }
  .form-missing p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── After the form ── */
  .after-form {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .after-form p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.7;
  }
  .after-form .small {
    font-size: 0.83rem;
    margin-top: 0.6rem;
  }
  .after-form a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .container { padding: 0 1.25rem; }
    .page-hero { padding: 3.5rem 0 1.5rem; }
    .form-embed { height: 1750px; }
    .form-missing { padding: 1.75rem; }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';

const images = [
  // Add images here later like:
  // { src: '/gallery/photo1.jpg', alt: 'Description' },
];
---

<Layout title="Galerie — Ariadna Balsells" lang="fr">

  <section class="gallery-hero">
    <div class="container">
      <p class="eyebrow">Galerie</p>
      <h1>Photos & Vidéos</h1>
      <p class="subtitle">Quelques moments du quotidien au cabinet.</p>
    </div>
  </section>

  <section class="gallery-section">
    <div class="container">
      {images.length === 0 ? (
        <div class="empty">
          <p>La galerie arrive bientôt ✨</p>
        </div>
      ) : (
        <div class="gallery-grid">
          {images.map(img => (
            <div class="gallery-item">
              <img src={img.src} alt={img.alt} />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

</Layout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
  .eyebrow {
    font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-accent); font-weight: 500; margin-bottom: 0.75rem;
  }

  /* Hero */
  .gallery-hero { padding: 5rem 0 3rem; }
  .gallery-hero h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; }
  .subtitle { color: var(--color-text-light); font-size: 1.05rem; }

  /* Empty state */
  .gallery-section { padding: 3rem 0 6rem; }
  .empty {
    text-align: center;
    padding: 6rem 2rem;
    border: 2px dashed var(--color-border);
    border-radius: 16px;
    color: var(--color-text-light);
    font-size: 1.1rem;
  }

  /* Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .gallery-item {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-border);
  }
  .gallery-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .gallery-item:hover img { transform: scale(1.04); }

  @media (max-width: 768px) {
    .gallery-hero { padding: 3rem 0 2rem; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
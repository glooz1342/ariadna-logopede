---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ariadna Balsells — Logopède à Bruxelles" lang="fr"
  description="Logopède à Woluwe-Saint-Lambert, Bruxelles. Consultations pour enfants et adultes : troubles du langage, de la parole, de la lecture et de l'écriture.">

  <!-- Hero -->
<section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Logopède à Bruxelles</p>
      <h1>Ariadna Balsells</h1>
      <p class="hero-sub">
        Un accompagnement bienveillant et personnalisé pour chaque enfant et chaque adulte,
        quel que soit son parcours.
      </p>
      <div class="hero-actions">
        <a href="/fr/contact" class="btn-primary">Prendre rendez-vous</a>
        <a href="/fr/galerie" class="btn-secondary">Découvrir la galerie</a>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/Ari.jpeg" alt="Ariadna Balsells, logopède à Bruxelles" />
    </div>
  </section>

  <!-- Services -->
  <section class="services" id="consultations">
    <div class="container">
      <p class="section-label">Ce que je propose</p>
      <h2>Domaines d'intervention</h2>
      <div class="services-grid">
        <details class="service-card">
          <summary>
            <div class="card-num">01</div>
            <h3>Troubles du langage oral</h3>
            <p class="card-desc">Difficultés d'expression, de compréhension ou d'articulation chez l'enfant et l'adulte.</p>
            <span class="card-toggle">Voir des exemples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Retard de parole ou de langage</li>
            <li>Difficultés de compréhension</li>
            <li>Troubles de l'articulation</li>
            <li>Bégaiement</li>
            <li>Manque de vocabulaire</li>
            <li>Difficultés à construire des phrases</li>
          </ul>
        </details>
        <details class="service-card">
          <summary>
            <div class="card-num">02</div>
            <h3>Communication Alternative et Augmentée</h3>
            <p class="card-desc">Mise en place d'outils de CAA pour les personnes ayant des difficultés de communication verbale.</p>
            <span class="card-toggle">Voir des exemples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Pictogrammes, gestes et applications de communication</li>
            <li>Choix de l'outil adapté au profil de chaque personne</li>
            <li>Accompagnement de la famille dans l'utilisation au quotidien</li>
            <li>Soutien du développement du langage en parallèle de l'outil</li>
          </ul>
        </details>
        <details class="service-card">
          <summary>
            <div class="card-num">03</div>
            <h3>Troubles neurodéveloppementaux</h3>
            <p class="card-desc">Accompagnement des personnes avec TSA, trisomie 21, syndrome génétique ou déficience intellectuelle.</p>
            <span class="card-toggle">Voir des exemples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Trouble du spectre de l'autisme (TSA)</li>
            <li>Trisomie 21 et syndromes génétiques</li>
            <li>Déficience intellectuelle</li>
            <li>Travail sur la communication et les interactions sociales</li>
          </ul>
        </details>
        <details class="service-card">
          <summary>
            <div class="card-num">04</div>
            <h3>Trouble spécifique des apprentissages en mathématiques</h3>
            <p class="card-desc">Prise en charge des difficultés spécifiques en mathématiques et dans le raisonnement numérique.</p>
            <span class="card-toggle">Voir des exemples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Difficultés à compter, calculer ou mémoriser les tables</li>
            <li>Trouble du sens du nombre et des quantités</li>
            <li>Difficultés de raisonnement logico-mathématique</li>
            <li>Répercussions sur les apprentissages scolaires</li>
          </ul>
        </details>
        <details class="service-card">
          <summary>
            <div class="card-num">05</div>
            <h3>Troubles alimentaires pédiatriques</h3>
            <p class="card-desc">Accompagnement des enfants présentant des difficultés lors des repas : sélectivité, textures, oralité.</p>
            <span class="card-toggle">Voir des exemples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Refus alimentaire sélectif</li>
            <li>Hypersensibilité aux textures ou saveurs</li>
            <li>Difficultés de mastication ou déglutition</li>
            <li>Repas très longs ou agités</li>
            <li>Peur des aliments nouveaux (néophobie)</li>
            <li>Troubles liés à la prématurité ou pathologies associées</li>
          </ul>
        </details>
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="about">
    <div class="container about-inner">
      <div class="about-text">
        <p class="section-label">À propos</p>
        <h2>Une approche centrée sur la personne</h2>
        <p>
          Je suis Ariadna Balsells, logopède basée à Bruxelles. Mon travail s'articule autour 
          d'une conviction forte : chaque personne a sa propre façon de communiquer, et mon rôle 
          est de l'accompagner avec respect et créativité.
        </p>
        <a href="/fr/apropos" class="btn-outline">En savoir plus</a>
      </div>
      <div class="about-deco" aria-hidden="true">
        <div class="circle-outer">
          <div class="circle-inner"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container">
      <h2>Vous souhaitez prendre rendez-vous ?</h2>
      <p>N'hésitez pas à me contacter pour toute question ou pour planifier une première consultation.</p>
      <a href="/fr/contact" class="btn-primary">Me contacter</a>
    </div>
  </section>

</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  /* ── Hero ── */
  .hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 2rem 6rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .hero-inner { max-width: 560px; }
  .hero-photo img {
    width: 300px;
    height: 300px;
    object-fit: cover;
    object-position: center top;
    border-radius: 50%;
    border: 4px solid rgba(123,158,135,0.25);
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    display: block;
  }
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 600;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--color-text-light);
    line-height: 1.75;
    margin-bottom: 2.5rem;
    max-width: 500px;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }


  /* ── Buttons ── */
  .btn-primary {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--color-accent-dark); }

  .btn-secondary {
    display: inline-block;
    color: var(--color-text);
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    transition: all 0.2s;
  }
  .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .btn-outline {
    display: inline-block;
    color: var(--color-accent);
    padding: 0.75rem 1.75rem;
    border: 1.5px solid var(--color-accent);
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
    margin-top: 1.5rem;
  }
  .btn-outline:hover { background: var(--color-accent); color: white; }

  /* ── Services ── */
  .services {
    background: white;
    padding: 5rem 0;
  }
  .services h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 3rem;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .services-grid { align-items: start; }
  .service-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    transition: all 0.25s;
  }
  .service-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 10px 28px rgba(123,158,135,0.1);
  }
  .service-card summary {
    list-style: none;
    cursor: pointer;
    padding: 2rem;
  }
  .service-card summary::-webkit-details-marker { display: none; }
  .card-num {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.85rem;
  }
  .service-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
    color: var(--color-text);
  }
  .card-desc {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.65;
  }
  .card-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent);
  }
  .card-toggle svg { transition: transform 0.2s; }
  .service-card[open] .card-toggle svg { transform: rotate(180deg); }
  .card-bullets {
    list-style: none;
    padding: 0 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .card-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: var(--color-text-light);
    line-height: 1.55;
  }
  .card-bullets li::before {
    content: '';
    display: block;
    width: 7px;
    height: 7px;
    min-width: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    margin-top: 0.42em;
  }

  /* ── About ── */
  .about { padding: 5rem 0; }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .about-text h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1.25rem;
  }
  .about-text p {
    color: var(--color-text-light);
    line-height: 1.8;
  }
  .about-deco { display: flex; justify-content: center; }
  .circle-outer {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(123,158,135,0.14), rgba(123,158,135,0.04));
    border: 1.5px solid rgba(123,158,135,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .circle-inner {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 1px solid rgba(123,158,135,0.15);
  }

  /* ── CTA ── */
  .cta {
    background: white;
    border-top: 1px solid var(--color-border);
    padding: 5rem 0;
    text-align: center;
  }
  .cta h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1rem;
  }
  .cta p {
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 3rem 1.5rem 3rem;
      gap: 2rem;
      text-align: center;
    }
    .hero-inner { max-width: 100%; }
    .hero-photo { display: flex; justify-content: center; order: -1; }
    .hero-photo img { width: 200px; height: 200px; }
    .hero-actions { justify-content: center; }

    .services { padding: 3rem 0; }
    .services-grid { grid-template-columns: 1fr; }

    .about { padding: 3rem 0; }
    .about-inner { grid-template-columns: 1fr; gap: 2rem; }
    .about-deco { display: none; }

    .cta { padding: 3rem 0; }

    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
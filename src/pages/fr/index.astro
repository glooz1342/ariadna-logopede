---
import Layout from '../../layouts/Layout.astro';
import DomainCard from '../../components/DomainCard.astro';

// ── Domaines d'intervention ──
// APERÇU : le premier encadré remplace les 5 anciennes cartes dépliantes.
// Les deux autres (apprentissages / alimentation-oralité) restent à rédiger
// par Ari sur le même modèle, il suffit d'ajouter un objet à cette liste.
const domaines = [
  {
    title: 'Communication et langage',
    icon: '💬',
    tint: 'lavender' as const,
    intro: "L'accompagnement du langage, de la parole et de la communication chez l'enfant, qu'il s'agisse d'une difficulté spécifique ou d'un trouble neurodéveloppemental.",
    headings: ["J'accompagne", 'Concrètement, chez votre enfant'] as [string, string],
    terms: [
      { term: 'Retard de parole et de langage' },
      { term: 'Trouble développemental du langage', sub: '(TDL)' },
      { term: 'Dyspraxie verbale' },
    ],
    observations: [
      "Il parle peu, tard ou moins bien que les enfants de son âge",
      "Il cherche ses mots ou construit mal ses phrases",
      "Il comprend difficilement les consignes",
      "On a du mal à le comprendre quand il parle",
    ],
    assoc: {
      lead: "J'accompagne aussi le langage et la communication lorsqu'ils sont affectés par une condition associée :",
      conditions: [
        {
          title: "Trouble du spectre de l'autisme (TSA)",
          desc: 'Soutenir les interactions et développer la communication, verbale ou non.',
          featured: true,
        },
        {
          title: 'Trisomie 21',
          desc: 'Accompagner le langage et la parole tout au long du développement.',
        },
        {
          title: 'Syndromes génétiques',
          desc: "Adapter l'accompagnement du langage à chaque profil.",
        },
        {
          title: 'Déficience intellectuelle',
          desc: "Adapter la communication au rythme et aux capacités de l'enfant.",
        },
      ],
    },
    note: "Soutenir la communication étant au cœur de ce domaine, il est fréquent que la mise en place d'un outil de <strong>communication alternative &amp; améliorée (CAA)</strong> devienne l'un des objectifs du suivi, selon le profil de l'enfant.",
  },
  {
    title: 'Alimentation',
    icon: '🍽️',
    tint: 'mint' as const,
    intro: "L'accompagnement des <strong>troubles alimentaires pédiatriques (TAP)</strong> chez l'enfant, du nourrisson au plus grand, dans leurs dimensions sensorielle, motrice et comportementale.",
    headings: ["J'accompagne", 'Concrètement, chez votre enfant'] as [string, string],
    terms: [
      { term: 'Sélectivité alimentaire' },
      { term: 'Hyper- ou hyposensibilité sensorielle', sub: '(textures, odeurs, goûts)' },
      { term: 'Difficultés de mastication et de déglutition', sub: '(dysphagie)' },
    ],
    observations: [
      "Il ne mange que quelques aliments, toujours les mêmes",
      "Certaines textures ou odeurs le dégoûtent au point qu'il recrache ou repousse l'assiette",
      "Ou au contraire il ne sent pas bien les aliments et se remplit trop la bouche",
      "Il garde les aliments en bouche, s'étouffe ou les repas n'en finissent pas",
    ],
    assoc: {
      lead: "J'accompagne aussi l'alimentation lorsqu'elle est fragilisée par une condition associée :",
      conditions: [
        {
          title: "Trouble du spectre de l'autisme (TSA)",
          desc: "La sélectivité y est très fréquente. J'élargis le répertoire au rythme de l'enfant, selon son profil sensoriel.",
          featured: true,
        },
        {
          title: 'Trisomie 21',
          desc: 'Soutenir la mastication et la déglutition, souvent fragilisées.',
        },
        {
          title: 'Syndromes génétiques',
          desc: "Soutenir l'alimentation selon les particularités du syndrome.",
        },
        {
          title: 'Prématurité et parcours médical',
          desc: 'Restaurer les compétences alimentaires après une sonde, un RGO ou un séjour hospitalier.',
        },
      ],
    },
  },
];
---

<Layout title="Ariadna Balsells | Logopède à Bruxelles" lang="fr"
  description="Logopède à Woluwe-Saint-Lambert, Bruxelles. Consultations pour enfants et adultes : troubles du langage, de la parole, de la lecture et de l'écriture.">

  <!-- Hero -->
<section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Logopède à Bruxelles</p>
      <h1>Ariadna Balsells</h1>
      <p class="hero-sub">
        Un accompagnement bienveillant et personnalisé pour chaque enfant et chaque adulte,
        quel que soit son parcours.
      </p>
      <div class="hero-actions">
        <a href="/fr/contact" class="btn-primary">Prendre rendez-vous</a>
        <a href="/fr/galerie" class="btn-secondary">Découvrir la galerie</a>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/Ari.jpeg" alt="Ariadna Balsells, logopède à Bruxelles" />
    </div>
  </section>

  <!-- Services -->
  <section class="services" id="consultations">
    <div class="container">
      <p class="section-label">Ce que je propose</p>
      <h2>Domaines d'intervention</h2>
      <div class="domaines">
        {domaines.map(d => (
          <DomainCard
            title={d.title}
            intro={d.intro}
            headings={d.headings}
            terms={d.terms}
            observations={d.observations}
            assoc={d.assoc}
            note={d.note}
            icon={d.icon}
            tint={d.tint}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="about">
    <div class="container about-inner">
      <div class="about-text">
        <p class="section-label">À propos</p>
        <h2>Une approche centrée sur la personne</h2>
        <p>
          Je suis Ariadna Balsells, logopède basée à Bruxelles. Mon travail s'articule autour 
          d'une conviction forte : chaque personne a sa propre façon de communiquer, et mon rôle 
          est de l'accompagner avec respect et créativité.
        </p>
        <a href="/fr/apropos" class="btn-outline">En savoir plus</a>
      </div>
      <div class="about-deco" aria-hidden="true">
        <div class="circle-outer">
          <div class="circle-inner"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container">
      <h2>Vous souhaitez prendre rendez-vous ?</h2>
      <p>N'hésitez pas à me contacter pour toute question ou pour planifier une première consultation.</p>
      <a href="/fr/contact" class="btn-primary">Me contacter</a>
    </div>
  </section>

</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  /* ── Hero ── */
  .hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 2rem 6rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .hero-inner { max-width: 560px; }
  .hero-photo img {
    width: 300px;
    height: 300px;
    object-fit: cover;
    object-position: center top;
    border-radius: 50%;
    border: 4px solid var(--color-tint-mint);
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    display: block;
  }
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 600;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--color-text-light);
    line-height: 1.75;
    margin-bottom: 2.5rem;
    max-width: 500px;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }


  /* ── Buttons ── */
  .btn-primary {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--color-accent-dark); }

  .btn-secondary {
    display: inline-block;
    color: var(--color-text);
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    transition: all 0.2s;
  }
  .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .btn-outline {
    display: inline-block;
    color: var(--color-accent);
    padding: 0.75rem 1.75rem;
    border: 1.5px solid var(--color-accent);
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
    margin-top: 1.5rem;
  }
  .btn-outline:hover { background: var(--color-accent); color: white; }

  /* ── Services ── */
  .services {
    background: white;
    padding: 5rem 0;
  }
  .services h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 3rem;
  }
  .domaines {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── About ── */
  .about { padding: 5rem 0; }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .about-text h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1.25rem;
  }
  .about-text p {
    color: var(--color-text-light);
    line-height: 1.8;
  }
  .about-deco { display: flex; justify-content: center; }
  .circle-outer {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-tint-mint), color-mix(in srgb, var(--color-tint-mint) 25%, white));
    border: 1.5px solid var(--color-tint-mint);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .circle-inner {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-tint-mint) 70%, white);
  }

  /* ── CTA ── */
  .cta {
    background: white;
    border-top: 1px solid var(--color-border);
    padding: 5rem 0;
    text-align: center;
  }
  .cta h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1rem;
  }
  .cta p {
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 3rem 1.5rem 3rem;
      gap: 2rem;
      text-align: center;
    }
    .hero-inner { max-width: 100%; }
    .hero-photo { display: flex; justify-content: center; order: -1; }
    .hero-photo img { width: 200px; height: 200px; }
    .hero-actions { justify-content: center; }

    .services { padding: 3rem 0; }
    .services-grid { grid-template-columns: 1fr; }

    .about { padding: 3rem 0; }
    .about-inner { grid-template-columns: 1fr; gap: 2rem; }
    .about-deco { display: none; }

    .cta { padding: 3rem 0; }

    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ariadna Balsells — Speech Therapist in Brussels" lang="en"
  description="Speech therapist in Woluwe-Saint-Lambert, Brussels. Consultations for children and adults: language, speech, reading and writing difficulties.">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Speech Therapist in Brussels</p>
      <h1>Ariadna Balsells</h1>
      <p class="hero-sub">
        Caring, personalised support for every child and adult,
        whatever their background or needs.
      </p>
      <div class="hero-actions">
        <a href="/en/contact" class="btn-primary">Book an appointment</a>
        <a href="/en/gallery" class="btn-secondary">Discover my Gallery</a>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/Ari.jpeg" alt="Ariadna Balsells, speech therapist in Brussels" />
    </div>
  </section>

  <!-- Services -->
  <section class="services" id="areas-of-practice">
    <div class="container">
      <p class="section-label">What I offer</p>
      <h2>Areas of practice</h2>
      <div class="services-grid">
        <details class="service-card">
          <summary>
            <div class="card-num">01</div>
            <h3>Oral language disorders</h3>
            <p class="card-desc">Difficulties with expression, comprehension or articulation in children and adults.</p>
            <span class="card-toggle">See examples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Speech or language delay</li>
            <li>Comprehension difficulties</li>
            <li>Articulation disorders</li>
            <li>Stuttering</li>
            <li>Limited vocabulary</li>
            <li>Difficulty building sentences</li>
          </ul>
        </details>
        <details class="service-card">
          <summary>
            <div class="card-num">02</div>
            <h3>Augmentative and Alternative Communication</h3>
            <p class="card-desc">Setting up AAC tools for people with verbal communication difficulties.</p>
            <span class="card-toggle">See examples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Pictograms, gestures and communication apps</li>
            <li>Choosing the right tool for each person's profile</li>
            <li>Supporting families in day-to-day use</li>
            <li>Developing language alongside the tool</li>
          </ul>
        </details>
        <details class="service-card">
          <summary>
            <div class="card-num">03</div>
            <h3>Neurodevelopmental disorders</h3>
            <p class="card-desc">Support for people with ASD, Down syndrome, genetic syndromes or intellectual disabilities.</p>
            <span class="card-toggle">See examples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Autism spectrum disorder (ASD)</li>
            <li>Down syndrome and genetic syndromes</li>
            <li>Intellectual disability</li>
            <li>Work on communication and social interaction</li>
          </ul>
        </details>
        <details class="service-card">
          <summary>
            <div class="card-num">04</div>
            <h3>Dyscalculia</h3>
            <p class="card-desc">Assessment and support for specific learning difficulties in mathematics and numerical reasoning.</p>
            <span class="card-toggle">See examples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Difficulty counting, calculating or memorising tables</li>
            <li>Impaired number sense and understanding of quantities</li>
            <li>Difficulties with logical-mathematical reasoning</li>
            <li>Impact on school learning</li>
          </ul>
        </details>
        <details class="service-card">
          <summary>
            <div class="card-num">05</div>
            <h3>Paediatric feeding disorders</h3>
            <p class="card-desc">Support for children with difficulties at mealtimes: food selectivity, textures and oral-motor challenges.</p>
            <span class="card-toggle">See examples <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <ul class="card-bullets">
            <li>Selective food refusal</li>
            <li>Hypersensitivity to textures or flavours</li>
            <li>Chewing or swallowing difficulties</li>
            <li>Very long or distressing mealtimes</li>
            <li>Fear of new foods (food neophobia)</li>
            <li>Difficulties linked to prematurity or associated conditions</li>
          </ul>
        </details>
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="about">
    <div class="container about-inner">
      <div class="about-text">
        <p class="section-label">About</p>
        <h2>A person-centred approach</h2>
        <p>
          I am Ariadna Balsells, a speech therapist based in Brussels. My work is built around 
          a strong belief: every person has their own way of communicating, and my role is 
          to support them with respect and creativity.
        </p>
        <a href="/en/about" class="btn-outline">Learn more</a>
      </div>
      <div class="about-deco" aria-hidden="true">
        <div class="circle-outer">
          <div class="circle-inner"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container">
      <h2>Would you like to book an appointment?</h2>
      <p>Feel free to get in touch with any questions or to schedule an initial consultation.</p>
      <a href="/en/contact" class="btn-primary">Contact me</a>
    </div>
  </section>

</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .section-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }
  .hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 2rem 6rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .hero-inner { max-width: 560px; }
  .hero-photo img {
    width: 300px;
    height: 300px;
    object-fit: cover;
    object-position: center top;
    border-radius: 50%;
    border: 4px solid var(--color-tint-mint);
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    display: block;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 600;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--color-text-light);
    line-height: 1.75;
    margin-bottom: 2.5rem;
    max-width: 500px;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
 
  .btn-primary {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--color-accent-dark); }
  .btn-secondary {
    display: inline-block;
    color: var(--color-text);
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    transition: all 0.2s;
  }
  .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .btn-outline {
    display: inline-block;
    color: var(--color-accent);
    padding: 0.75rem 1.75rem;
    border: 1.5px solid var(--color-accent);
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
    margin-top: 1.5rem;
  }
  .btn-outline:hover { background: var(--color-accent); color: white; }
  .services { background: white; padding: 5rem 0; }
  .services h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 3rem; }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .services-grid { align-items: start; }
  .service-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    transition: all 0.25s;
  }
  .service-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 10px 28px rgba(44,44,44,0.10);
  }
  .service-card summary {
    list-style: none;
    cursor: pointer;
    padding: 2rem;
  }
  .service-card summary::-webkit-details-marker { display: none; }
  .card-num {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.85rem;
  }
  .service-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
    color: var(--color-text);
  }
  .card-desc {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.65;
  }
  .card-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent);
  }
  .card-toggle svg { transition: transform 0.2s; }
  .service-card[open] .card-toggle svg { transform: rotate(180deg); }
  .card-bullets {
    list-style: none;
    padding: 0 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .card-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: var(--color-text-light);
    line-height: 1.55;
  }
  .card-bullets li::before {
    content: '';
    display: block;
    width: 7px;
    height: 7px;
    min-width: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    margin-top: 0.42em;
  }
  .about { padding: 5rem 0; }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .about-text h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1.25rem; }
  .about-text p { color: var(--color-text-light); line-height: 1.8; }
  .about-deco { display: flex; justify-content: center; }
  .circle-outer {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-tint-mint), color-mix(in srgb, var(--color-tint-mint) 25%, white));
    border: 1.5px solid var(--color-tint-mint);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .circle-inner {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-tint-mint) 70%, white);
  }
  .cta {
    background: white;
    border-top: 1px solid var(--color-border);
    padding: 5rem 0;
    text-align: center;
  }
  .cta h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1rem; }
  .cta p { color: var(--color-text-light); margin-bottom: 2rem; }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 3rem 1.5rem 3rem;
      gap: 2rem;
      text-align: center;
    }
    .hero-inner { max-width: 100%; }
    .hero-photo { display: flex; justify-content: center; order: -1; }
    .hero-photo img { width: 200px; height: 200px; }
    .hero-actions { justify-content: center; }

    .services { padding: 3rem 0; }
    .services-grid { grid-template-columns: 1fr; }

    .about { padding: 3rem 0; }
    .about-inner { grid-template-columns: 1fr; gap: 2rem; }
    .about-deco { display: none; }

    .cta { padding: 3rem 0; }

    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
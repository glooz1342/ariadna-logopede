---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ariadna Balsells — Speech Therapist in Brussels" lang="en">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Speech Therapist in Brussels</p>
      <h1>Ariadna Balsells</h1>
      <p class="hero-sub">
        Caring, personalised support for every child and adult,
        whatever their background or needs.
      </p>
      <div class="hero-actions">
        <a href="/en/contact" class="btn-primary">Book an appointment</a>
        <a href="/en/services" class="btn-secondary">Discover my Gallery</a>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/Ari.jpeg" alt="Ariadna Balsells, speech therapist in Brussels" />
    </div>
  </section>

  <!-- Services -->
  <section class="services">
    <div class="container">
      <p class="section-label">What I offer</p>
      <h2>Areas of practice</h2>
      <div class="services-grid">
        <div class="service-card">
          <div class="card-num">01</div>
          <h3>Oral language disorders</h3>
          <p>Difficulties with expression, comprehension or articulation in children and adults.</p>
        </div>
        <div class="service-card">
          <div class="card-num">02</div>
          <h3>Augmentative and Alternative Communication</h3>
          <p>Setting up AAC tools for people with verbal communication difficulties.</p>
        </div>
        <div class="service-card">
          <div class="card-num">03</div>
          <h3>Neurodevelopmental disorders</h3>
          <p>Support for people with ASD, Down syndrome, genetic syndromes or intellectual disabilities.</p>
        </div>
        <div class="service-card">
          <div class="card-num">04</div>
          <h3>Dyscalculia</h3>
          <p>Assessment and support for specific learning difficulties in mathematics and numerical reasoning.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="about">
    <div class="container about-inner">
      <div class="about-text">
        <p class="section-label">About</p>
        <h2>A person-centred approach</h2>
        <p>
          I am Ariadna Balsells, a speech therapist based in Brussels. My work is built around 
          a strong belief: every person has their own way of communicating, and my role is 
          to support them with respect and creativity.
        </p>
        <a href="/en/about" class="btn-outline">Learn more</a>
      </div>
      <div class="about-deco" aria-hidden="true">
        <div class="circle-outer">
          <div class="circle-inner"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container">
      <h2>Would you like to book an appointment?</h2>
      <p>Feel free to get in touch with any questions or to schedule an initial consultation.</p>
      <a href="/en/contact" class="btn-primary">Contact me</a>
    </div>
  </section>

</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .section-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }
  .hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 2rem 6rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .hero-inner { max-width: 560px; }
  .hero-photo img {
    width: 300px;
    height: 300px;
    object-fit: cover;
    object-position: center top;
    border-radius: 50%;
    border: 4px solid rgba(123,158,135,0.25);
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    display: block;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 600;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--color-text-light);
    line-height: 1.75;
    margin-bottom: 2.5rem;
    max-width: 500px;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
 
  .btn-primary {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--color-accent-dark); }
  .btn-secondary {
    display: inline-block;
    color: var(--color-text);
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    transition: all 0.2s;
  }
  .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .btn-outline {
    display: inline-block;
    color: var(--color-accent);
    padding: 0.75rem 1.75rem;
    border: 1.5px solid var(--color-accent);
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
    margin-top: 1.5rem;
  }
  .btn-outline:hover { background: var(--color-accent); color: white; }
  .services { background: white; padding: 5rem 0; }
  .services h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 3rem; }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .service-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.25s;
  }
  .service-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(123,158,135,0.1);
  }
  .card-num {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.85rem;
  }
  .service-card h3 { font-size: 1.05rem; margin-bottom: 0.6rem; }
  .service-card p { font-size: 0.9rem; color: var(--color-text-light); line-height: 1.65; }
  .about { padding: 5rem 0; }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .about-text h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1.25rem; }
  .about-text p { color: var(--color-text-light); line-height: 1.8; }
  .about-deco { display: flex; justify-content: center; }
  .circle-outer {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(123,158,135,0.14), rgba(123,158,135,0.04));
    border: 1.5px solid rgba(123,158,135,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .circle-inner {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 1px solid rgba(123,158,135,0.15);
  }
  .cta {
    background: white;
    border-top: 1px solid var(--color-border);
    padding: 5rem 0;
    text-align: center;
  }
  .cta h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1rem; }
  .cta p { color: var(--color-text-light); margin-bottom: 2rem; }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 3rem 1.5rem 3rem;
      gap: 2rem;
      text-align: center;
    }
    .hero-inner { max-width: 100%; }
    .hero-photo { display: flex; justify-content: center; order: -1; }
    .hero-photo img { width: 200px; height: 200px; }
    .hero-actions { justify-content: center; }

    .services { padding: 3rem 0; }
    .services-grid { grid-template-columns: 1fr; }

    .about { padding: 3rem 0; }
    .about-inner { grid-template-columns: 1fr; gap: 2rem; }
    .about-deco { display: none; }

    .cta { padding: 3rem 0; }

    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
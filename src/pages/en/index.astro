---
import Layout from '../../layouts/Layout.astro';
import { ROSA_URL } from '../../data/booking';
import DomainCard from '../../components/DomainCard.astro';

// ── Areas of practice ──
// English counterpart of the FR encadrés. DRAFT TRANSLATION — awaiting
// Ari's sign-off on the clinical terminology (DLD, PFD, MLD) before this
// is treated as final copy.
const domains = [
  {
    title: 'Communication and language',
    icon: '💬',
    tint: 'lavender' as const,
    intro: "Support with language, speech and communication in children, whether the difficulty is specific or part of a neurodevelopmental disorder.",
    headings: ['I support', 'What you may notice in your child'] as [string, string],
    terms: [
      { term: 'Speech and language delay' },
      { term: 'Developmental Language Disorder', sub: '(DLD)' },
      { term: 'Childhood apraxia of speech', sub: '(verbal dyspraxia)' },
    ],
    observations: [
      'They speak little, started late, or less clearly than other children their age',
      'They search for words or struggle to build sentences',
      'They find it hard to follow instructions',
      'People struggle to understand them when they speak',
    ],
    assoc: {
      lead: 'I also support language and communication when they are affected by an associated condition:',
      conditions: [
        {
          title: 'Autism spectrum disorder (ASD)',
          desc: 'Supporting interaction and developing communication, verbal or not.',
          featured: true,
        },
        {
          title: 'Down syndrome',
          desc: 'Supporting language and speech throughout development.',
        },
        {
          title: 'Genetic syndromes',
          desc: 'Adapting language support to each profile.',
        },
        {
          title: 'Intellectual disability',
          desc: "Adapting communication to the child's pace and abilities.",
        },
      ],
    },
    note: "As supporting communication is central to this area, setting up an <strong>augmentative and alternative communication (AAC)</strong> tool often becomes one of the goals of therapy, depending on the child's profile.",
  },
  {
    title: 'Feeding',
    icon: '🍽️',
    tint: 'mint' as const,
    intro: "Support with <strong>paediatric feeding disorders (PFD)</strong> in children, from infancy upwards, across their sensory, motor and behavioural dimensions.",
    headings: ['I support', 'What you may notice in your child'] as [string, string],
    terms: [
      { term: 'Food selectivity' },
      { term: 'Sensory hyper- or hyposensitivity', sub: '(textures, smells, tastes)' },
      { term: 'Chewing and swallowing difficulties', sub: '(dysphagia)' },
    ],
    observations: [
      'They eat only a few foods, always the same ones',
      'Certain textures or smells put them off to the point of spitting food out or pushing the plate away',
      'Or conversely they barely feel the food and overfill their mouth',
      'They hold food in their mouth, choke, or meals drag on and on',
    ],
    assoc: {
      lead: 'I also support feeding when it is made harder by an associated condition:',
      conditions: [
        {
          title: 'Autism spectrum disorder (ASD)',
          desc: "Selectivity is very common here. I widen the range of foods at the child's pace, according to their sensory profile.",
          featured: true,
        },
        {
          title: 'Down syndrome',
          desc: 'Supporting chewing and swallowing, which are often fragile.',
        },
        {
          title: 'Genetic syndromes',
          desc: 'Supporting feeding according to the particularities of the syndrome.',
        },
        {
          title: 'Prematurity and medical history',
          desc: 'Restoring feeding skills after tube feeding, reflux or a hospital stay.',
        },
      ],
    },
  },
  {
    title: 'Mathematical cognition',
    icon: '🧮',
    tint: 'blue' as const,
    intro: "Support with difficulties in <strong>mathematical cognition</strong> in children: an umbrella term covering the whole range of difficulties in mathematics, including mathematics learning disorder (MLD), which today replaces ‘dyscalculia’.",
    headings: ['I support', 'What you may notice in your child'] as [string, string],
    terms: [
      { term: 'Mathematics learning disorder', sub: "(MLD, formerly ‘dyscalculia’)" },
      { term: 'Numerical cognition', sub: '(number sense, transcoding)' },
      { term: 'Arithmetic cognition', sub: '(calculation, problem solving)' },
    ],
    observations: [
      'They <strong>still count on their fingers</strong> and struggle to memorise <strong>times tables</strong>',
      '<strong>Setting out a sum</strong>, telling the time or giving change are a problem',
      'They <strong>struggle to solve word problems</strong> and to estimate quantities',
      'Their <strong>results in maths</strong> lag behind, despite the effort they put in',
    ],
    assoc: {
      lead: 'MLD is rarely isolated. I take account of the disorders it is frequently associated with:',
      conditions: [
        {
          title: 'Written language disorders (dyslexia, dysorthographia)',
          desc: 'The most common co-occurrence with MLD.',
          featured: true,
        },
        {
          title: 'Developmental Language Disorder (DLD)',
          desc: 'Language underpins reasoning and the wording of problems.',
        },
        {
          title: 'ADHD',
          desc: 'Attention and executive function weigh on learning.',
        },
        {
          title: 'Developmental Coordination Disorder (DCD)',
          desc: 'Possible impact on writing numbers and on geometry.',
        },
      ],
    },
  },
];
---

<Layout title="Ariadna Balsells | Speech Therapist in Brussels" lang="en"
  description="Ariadna Balsells, speech therapist in Woluwe-Saint-Lambert, Brussels. I support children with language, communication, feeding and mathematical learning.">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Speech Therapist in Brussels</p>
      <h1>Ariadna Balsells</h1>
      <p class="hero-sub">
        I support children in the development of language and communication, and in learning mathematics.
      </p>
      <div class="hero-actions">
        <a href={ROSA_URL.en} class="btn-primary" target="_blank" rel="noopener">Book an appointment online</a>
        <a href="/en/about/" class="btn-secondary">About me</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services reveal" id="areas-of-practice">
    <div class="container">
      <p class="section-label">What I offer</p>
      <h2>Areas of practice</h2>
      <div class="domains">
        {domains.map(d => (
          <DomainCard
            title={d.title}
            intro={d.intro}
            headings={d.headings}
            terms={d.terms}
            observations={d.observations}
            assoc={d.assoc}
            note={d.note}
            icon={d.icon}
            tint={d.tint}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="about reveal">
    <div class="container about-inner">
      <div class="about-text">
        <p class="section-label">About</p>
        <h2>A person-centred approach</h2>
        <p>
          I am Ariadna Balsells, a speech therapist based in Brussels. My work is built around 
          a strong belief: every child has their own way of communicating, and my role is 
          to support them with respect and creativity.
        </p>
        <a href="/en/about/" class="btn-outline">Learn more</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta reveal">
    <div class="container">
      <h2>Would you like to book an appointment?</h2>
      <p>Feel free to get in touch with any questions or to schedule an initial consultation.</p>
      <a href="/en/contact/" class="btn-primary">Contact me</a>
    </div>
  </section>

</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .section-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }
  .hero {
    background: var(--color-surface);
    padding: 7rem 2rem 6rem;
    text-align: center;
  }
  .hero-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 600;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--color-text-light);
    line-height: 1.75;
    margin: 0 auto 2.5rem;
    max-width: 560px;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
 
  .btn-primary {
    display: inline-block;
    background: var(--color-purple);
    color: white;
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--color-purple-dark); }
  .btn-secondary {
    display: inline-block;
    background: var(--color-bg);
    color: var(--color-text);
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    transition: background 0.2s, border-color 0.2s;
  }
  .btn-secondary:hover { border-color: var(--color-purple); color: var(--color-purple); }
  .btn-outline {
    display: inline-block;
    color: var(--color-accent);
    padding: 0.75rem 1.75rem;
    border: 1.5px solid var(--color-accent);
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
    margin-top: 1.5rem;
  }
  .btn-outline:hover { background: var(--color-accent); color: white; }
  .services { background: white; padding: 5rem 0; }
  .services h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 3rem; }
  .domains {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .about { padding: 5rem 0; }
  .about-inner {
    max-width: 700px;
  }
  .about-text h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1.25rem; }
  .about-text p { color: var(--color-text-light); line-height: 1.8; }
  .cta {
    background: white;
    border-top: 1px solid var(--color-border);
    padding: 5rem 0;
    text-align: center;
  }
  .cta h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1rem; }
  .cta p { color: var(--color-text-light); margin-bottom: 2rem; }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      padding: 3rem 1.5rem 3rem;
    }
    .hero-inner { max-width: 100%; }

    .services { padding: 3rem 0; }

    .about { padding: 3rem 0; }

    .cta { padding: 3rem 0; }

    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
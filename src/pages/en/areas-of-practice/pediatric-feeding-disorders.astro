<SpecialtyPage
  lang="en"
  title="Pediatric feeding disorders"
  subtitle="Supporting children with difficulties around mealtimes, food textures, or eating behaviour."
  pourquoi="Pediatric feeding disorders can have sensory, motor, or behavioural origins. They often create stress around mealtimes and can impact a child's growth and wellbeing. Tailored support helps make meals calmer and gradually broadens the child's range of accepted foods."
  deroulement={[
    "In-depth interview with parents to understand the child's feeding history.",
    "Observation of a meal or feeding situation.",
    "Gradual work on textures, flavours, and mealtime behaviour.",
    "Active involvement of parents throughout the therapeutic process.",
    "Coordination with other healthcare professionals when needed.",
  ]}
  bullets={[
    "Selective food refusal",
    "Hypersensitivity to textures or flavours",
    "Chewing or swallowing difficulties",
    "Very long or distressing mealtimes",
    "Fear of new foods (food neophobia)",
    "Difficulties linked to prematurity or associated conditions",
  ]}
/>
---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact — Ariadna Balsells" lang="en"
  description="Get in touch with Ariadna Balsells, speech therapist in Woluwe-Saint-Lambert. Appointments by preference via WhatsApp.">

  <section class="contact-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="tagline">For any questions or to book an appointment, feel free to reach out.</p>
    </div>
  </section>

  <section class="contact-main">
    <div class="container contact-grid">

      <div class="contact-info">

        <div class="contact-block booking-highlight">
          <div class="contact-block-icon">📅</div>
          <div>
            <h3>Book an appointment online <span class="badge">Recommended</span></h3>
            <p class="contact-note">Book a slot directly based on your availability: first consultation, feeding (TAP), dyscalculia or AAC.</p>
            <a href="https://cal.com/ariadna-balsells-logopede" class="btn-booking" target="_blank" rel="noopener">
              Book an appointment
            </a>
          </div>
        </div>

        <div class="contact-block whatsapp-highlight">
          <div class="contact-block-icon">💬</div>
          <div>
            <h3>WhatsApp</h3>
            <p class="contact-note">By far the fastest way to reach me. I respond much quicker via WhatsApp than by phone call.</p>
            <a href="https://wa.me/32474052583" class="btn-whatsapp" target="_blank" rel="noopener">
              Send a WhatsApp message
            </a>
          </div>
        </div>

        <div class="contact-block">
          <div class="contact-block-icon">📞</div>
          <div>
            <h3>Phone</h3>
            <p class="contact-note">Available, but I rarely pick up during sessions. WhatsApp is much preferred for a quick reply.</p>
            <a href="tel:+32474052583">+32 474 05 25 83</a>
          </div>
        </div>

        <div class="contact-block">
          <div class="contact-block-icon">✉️</div>
          <div>
            <h3>Email</h3>
            <a href="mailto:ariadna.logopede@gmail.com">ariadna.logopede@gmail.com</a>
          </div>
        </div>

        <div class="contact-block">
          <div class="contact-block-icon">📍</div>
          <div>
            <h3>Practice</h3>
            <p>CAP'S — Centre d'Accompagnement Pédiatrique Spécialisé<br>
            Pl. de la Sainte-Famille 23<br>
            1200 Woluwe-Saint-Lambert</p>
          </div>
        </div>

        <div class="contact-block">
          <div class="contact-block-icon">🪪</div>
          <div>
            <h3>Professional information</h3>
            <p>INAMI number: 6-09831-08-802<br>
            BCE number: 1033.892.019</p>
          </div>
        </div>

      </div>

      <div class="contact-map">
        <iframe
          title="Practice location"
          src="https://maps.google.com/maps?q=Pl.+de+la+Sainte-Famille+23,+1200+Woluwe-Saint-Lambert,+Belgium&output=embed&z=15"
          width="100%"
          height="100%"
          style="border:0; border-radius: 16px;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>

    </div>
  </section>

</Layout>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .contact-hero {
    padding: 80px 0 40px;
    text-align: center;
  }

  .contact-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-text);
    margin: 0.25em 0;
  }

  .contact-hero .tagline {
    color: var(--color-text-light);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .contact-main {
    padding: 40px 0 100px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-block {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px;
    background: #f9f7f4;
    border-radius: 12px;
  }

  .contact-block-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-block h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 6px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .contact-block p, .contact-block a {
    font-size: 0.95rem;
    color: var(--color-text-light);
    margin: 0;
    line-height: 1.5;
  }

  .contact-block a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .contact-block a:hover {
    text-decoration: underline;
  }

  .contact-note {
    margin-bottom: 12px !important;
    font-size: 0.875rem !important;
    font-style: italic;
  }

  .whatsapp-highlight {
    border: 1px solid var(--color-border);
    background: var(--color-surface, #f9f7f4);
  }

  .booking-highlight {
    border: 2px solid var(--color-accent);
    background: #f3f7f4;
  }

  .btn-booking {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 10px 20px;
    background: var(--color-accent);
    color: white !important;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none !important;
    transition: background 0.2s;
  }

  .btn-booking:hover {
    background: var(--color-accent-dark);
  }

  .badge {
    background: var(--color-accent);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 10px 20px;
    background: #25D366;
    color: white !important;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none !important;
    transition: background 0.2s;
  }

  .btn-whatsapp:hover {
    background: #1ebe5d;
  }

  .contact-map {
    height: 520px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    position: sticky;
    top: 100px;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-map {
      height: 260px;
      position: static;
    }
  }
</style>
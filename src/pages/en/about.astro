---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About | Ariadna Balsells" lang="en"
  description="Learn about Ariadna Balsells, qualified speech therapist based in Woluwe-Saint-Lambert, Brussels.">

  <section class="intro reveal">
    <div class="container">
      <div class="intro-inner">
        <div class="intro-photo">
          <img src="/Ari.jpeg" alt="Ariadna Balsells" />
        </div>
        <div class="intro-text">
          <p class="eyebrow">About</p>
          <h1>Ariadna Balsells</h1>
          <p class="tagline">Independent Speech Therapist · Brussels</p>
          <p>
            I hold a Master's degree in Speech Therapy with a specialisation in neurodevelopmental 
            and sensory disorders, and I currently work as an independent speech therapist at CAP'S 
            (Centre d'Accompagnement Pédiatrique Spécialisé) in Brussels.
          </p>
          <p>
            My clinical path has taken me through hospitals, specialist schools and paediatric centres, 
            working alongside children with very diverse profiles. This has taught me to constantly 
            adapt my approach to the individual rather than following a fixed protocol.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="approach reveal">
    <div class="container">
      <h2>My approach</h2>
      <div class="pillars">
        <div class="pillar">
          <h3>Person-centred</h3>
          <p>Every child has their own way of communicating and learning. I always start from their 
          strengths, interests and pace, not a predetermined programme.</p>
        </div>
        <div class="pillar">
          <h3>Collaborative</h3>
          <p>I work closely with families and educational teams. Parental guidance is a core part of 
          my practice, because progress doesn't stop at the therapy room door.</p>
        </div>
        <div class="pillar">
          <h3>Evidence-based</h3>
          <p>I read the scientific literature and train continuously to keep my practice current. 
          I enjoy connecting research findings to real clinical situations.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="languages">
    <div class="container">
      <p class="section-label">Communication</p>
      <h2>Working languages</h2>
      <div class="lang-grid">
        <div class="lang-card">
          <p class="lang-name">French</p>
          <p class="lang-level">Native</p>
        </div>
        <div class="lang-card">
          <p class="lang-name">Spanish</p>
          <p class="lang-level">Native</p>
        </div>
        <div class="lang-card">
          <p class="lang-name">Italian</p>
          <p class="lang-level">Native</p>
        </div>
        <div class="lang-card">
          <p class="lang-name">English</p>
          <p class="lang-level">C2 level</p>
        </div>
        <div class="lang-card">
          <p class="lang-name">LSFB</p>
          <p class="lang-level">A2 level</p>
        </div>
      </div>
    </div>
  </section>

  <section class="continuous">
    <div class="container">
      <p class="section-label">Professional development</p>
      <h2>Continuing education</h2>
      <div class="training-list">
        <div class="training-item">
          <span class="training-year">2020-2023</span>
          <p>Bachelor's in Psychological &amp; Educational Sciences, Orientation: Speech Therapy &middot; UCLouvain</p>
        </div>
        <div class="training-item">
          <span class="training-year">2023-2025</span>
          <p>Master's in Speech Therapy, Specialisation: Neurodevelopmental &amp; Sensory Disorders &middot; UCLouvain</p>
        </div>
        <div class="training-item">
          <span class="training-year">2024</span>
          <p>ABA and severe behavioural disorders (challenging behaviour)</p>
        </div>
        <div class="training-item">
          <span class="training-year">2025</span>
          <p>AAC speech therapy intervention, Ornella Thys</p>
        </div>
        <div class="training-item">
          <span class="training-year">2026</span>
          <p>Paediatric feeding disorders, Pascale Grevesse, Brussels</p>
        </div>
        <div class="training-item">
          <span class="training-year">2026</span>
          <p>Motivational Interviewing (Miller &amp; Rollnick)</p>
        </div>
        <div class="training-item">
          <span class="training-year">2026</span>
          <p>Verbal dyspraxia: identification & intervention, Meloni & Charron, Paris</p>
        </div>
        <div class="training-item upcoming">
          <span class="training-year">Ongoing</span>
          <p>Certificate in Music Therapy</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Have a question?</h2>
      <p>Feel free to get in touch to learn more about my approach or to book an appointment.</p>
      <a href="/en/contact/" class="btn-primary">Contact me</a>
    </div>
  </section>

</Layout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
  .intro { padding: 5rem 0 4rem; }
  .intro-inner { display: grid; grid-template-columns: auto 1fr; gap: 4rem; align-items: start; }
  .intro-photo img {
    width: 220px; height: 220px; object-fit: cover; object-position: center 15%;
    border-radius: 50%; border: 4px solid var(--color-tint-mint);
    box-shadow: 0 12px 40px rgba(0,0,0,0.08); display: block;
  }
  .intro-text h1 { font-size: clamp(2rem, 3.5vw, 2.8rem); margin-bottom: 0.4rem; }
  .tagline { font-size: 0.85rem; color: var(--color-accent); letter-spacing: 0.05em; margin-bottom: 1.5rem; text-transform: uppercase; }
  .intro-text p { color: var(--color-text-light); line-height: 1.8; margin-bottom: 1rem; }
  .approach { background: white; padding: 5rem 0; }
  .approach h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 3rem; color: var(--color-accent); }
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .pillar { border-top: 2px solid var(--color-accent); padding-top: 1.5rem; }
  .pillar h3 { font-size: 1.05rem; margin-bottom: 0.75rem; }
  .pillar p { font-size: 0.9rem; color: var(--color-text-light); line-height: 1.7; }
  .formation { padding: 5rem 0; }
  .formation h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 3rem; }
  .timeline { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
  .timeline-block h3 {
    font-size: 0.85rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-accent); margin-bottom: 1.5rem; padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .timeline-items { display: flex; flex-direction: column; gap: 1.5rem; }
  .timeline-item { display: grid; grid-template-columns: 80px 1fr; gap: 1rem; align-items: start; }
  .year { font-size: 0.78rem; color: var(--color-accent); font-weight: 500; padding-top: 0.15rem; }
  .item-title { font-size: 0.95rem; font-weight: 500; color: var(--color-text); margin-bottom: 0.25rem; font-family: var(--font-heading); }
  .item-sub { font-size: 0.85rem; color: var(--color-text-light); line-height: 1.5; }
  .languages { background: white; padding: 5rem 0; }
  .languages h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 2rem; }
  .lang-grid { display: flex; gap: 1rem; flex-wrap: wrap; }
  .lang-card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: 10px; padding: 1.25rem 1.75rem; min-width: 150px;
  }
  .lang-name { font-family: var(--font-heading); font-size: 1rem; font-weight: 600; margin-bottom: 0.25rem; }
  .lang-level { font-size: 0.82rem; color: var(--color-accent); }
  .continuous { padding: 5rem 0; }
  .continuous h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 2rem; }
  .training-list { display: flex; flex-direction: column; max-width: 720px; }
  .training-item {
    display: grid; grid-template-columns: 90px 1fr; gap: 1rem;
    padding: 1rem 0; border-bottom: 1px solid var(--color-border); align-items: start;
  }
  .training-year { font-size: 0.78rem; color: var(--color-accent); font-weight: 500; padding-top: 0.1rem; }
  .training-item p { font-size: 0.92rem; color: var(--color-text); line-height: 1.5; }
  .training-item.upcoming .training-year { color: var(--color-text-light); }
  .training-item.upcoming p { color: var(--color-text-light); font-style: italic; }
  .cta { background: white; border-top: 1px solid var(--color-border); padding: 5rem 0; text-align: center; }
  .cta h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1rem; }
  .cta p { color: var(--color-text-light); margin-bottom: 2rem; }
  @media (max-width: 768px) {
    .intro { padding: 3rem 0; }
    .intro-inner { grid-template-columns: 1fr; text-align: center; gap: 2rem; }
    .intro-photo { display: flex; justify-content: center; }
    .intro-photo img { width: 160px; height: 160px; }
    .pillars { grid-template-columns: 1fr; }
    .timeline { grid-template-columns: 1fr; gap: 3rem; }
    .timeline-item { grid-template-columns: 70px 1fr; }
    .lang-grid { gap: 0.75rem; }
    .training-item { grid-template-columns: 75px 1fr; }
    .cta { padding: 3rem 0; }
  }
</style>
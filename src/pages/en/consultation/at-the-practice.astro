---
import Layout from '../../../layouts/Layout.astro';
import { ROSA_URL, WHATSAPP_URL } from '../../../data/booking';

// ⚠️ TO BE CONFIRMED BY ARI: mirrors the French page, validate together.

// Timeline: here the order matters, hence the numbering.
// Under each step, one button per area expands the details for that area.
const domains = [
  {
    "key": "langage",
    "label": "Oral language"
  },
  {
    "key": "tap",
    "label": "Feeding"
  },
  {
    "key": "maths",
    "label": "Mathematical cognition"
  }
] as const;

const steps = [
  {
    "title": "The first appointment",
    "text": "We take time to talk about your child: their development, their daily life, what you are wondering about and what you have already noticed. We also discuss your concerns and what brings you to consult.",
    "loop": false,
    "details": null,
    "notice": "In some cases, it is possible to apply to your health insurance fund for reimbursement approval. This requires a medical prescription for a speech and language assessment. Ask your doctor for one before the first appointment."
  },
  {
    "title": "The assessment",
    "text": "The assessment takes one or more sessions. Where possible, I use standardised tests to give an objective basis to what we observe. I also assess your child qualitatively, by watching how they go about things in different situations. The assessment is shaped by your request, to understand precisely how your child functions: their strengths and their areas of difficulty.",
    "loop": false,
    "details": {
      "langage": "I assess language (vocabulary, sentence building, speech sounds, comprehension), speech and communication: how your child connects with others, makes themselves understood and tells a story. When your child is growing up with several languages, I take this into account in the assessment.",
      "tap": "I observe a meal, ideally with foods your child accepts and others they find harder. I assess their eating and drinking skills: chewing, swallowing, handling textures, behaviour around food.",
      "maths": "I assess the foundations of number (perceiving quantities, counting, linking digits, number words and quantities), calculation and problem solving. I then place the results in relation to what is expected at their school level."
    },
    "notice": null
  },
  {
    "title": "The goals",
    "text": "Following the assessment, we agree on the goals together. We set concrete goals that make sense for your child and for you.",
    "loop": false,
    "details": {
      "langage": "A goal might be, for example, to be understood by classmates or to ask for help with a word, a sign or a pictogram.",
      "tap": "A goal might be, for example, to taste a new texture or to share the meal at the table with the rest of the family. When growth is a concern, goals are also set with the doctor.",
      "maths": "A goal might be, for example, to compare two quantities without counting one by one or to understand what a subtraction means in a word problem."
    },
    "notice": null
  },
  {
    "title": "Therapy",
    "text": "Therapy then begins, at the frequency recommended when we set the goals. I want to stress this: your involvement in therapy matters. For some types of therapy, you will even be asked to attend the sessions.",
    "loop": false,
    "details": {
      "langage": "Sessions are built around play and real communication situations. When it helps, I introduce augmentative and alternative communication (AAC): pictograms, signs or a digital tool. AAC supports the development of spoken language and gives your child a way to express themselves right now.",
      "tap": "Paediatric feeding disorders involve several dimensions at once: medical, nutritional, feeding skills and family experience. I therefore work closely with your child's doctor and the other professionals involved. New textures and foods are introduced gradually. Much of the work is done with you, around meals at home.",
      "maths": "The work aims at understanding before automatic recall, using concrete materials and visual representations. Where possible, I stay in touch with the school so that our sessions support what happens in class."
    },
    "notice": null
  },
  {
    "title": "Taking stock",
    "text": "At regular intervals, we look back together at the progress made. Once the goals are reached, we set new ones or bring the therapy to a close.",
    "loop": true,
    "details": {
      "langage": "I repeat some of the assessment tasks to measure progress. We also look at what has changed in everyday communication, at home and at school.",
      "tap": "We look at how the range of accepted foods has changed, how meals go at home and, with the doctor, how your child is growing.",
      "maths": "I repeat some of the assessment tasks and we compare the results with what the school observes in class."
    },
    "notice": null
  }
];
---

<Layout title="Consultation at the practice | Ariadna Balsells" lang="en"
  description="Speech and language therapy at CAP'S in Woluwe-Saint-Lambert: first appointment, assessment, goals and therapy for oral language, communication, feeding and mathematical cognition.">

  <section class="page-hero soft-band soft-band-top grain">
    <div class="container">
      <p class="eyebrow section-label">Consultation</p>
      <h1>At the practice</h1>
      <p class="tagline">
        Consultations take place at CAP'S in Woluwe-Saint-Lambert, in a space designed
        for children and their families.
      </p>
      <a href={ROSA_URL.en} class="btn-primary" target="_blank" rel="noopener">Book an appointment online</a>
    </div>
  </section>

  <section class="journey reveal soft-band band-on-ground">
    <div class="container">
      <p class="section-label">How it works</p>
      <h2>What therapy looks like</h2>
      <p class="journey-intro">Under each step, click on an area to see what it involves in your situation.</p>

      <ol class="timeline">
        {steps.map((s, i) => (
          <li class:list={['step', { 'step-loop': s.loop }]}>
            <span class="step-marker" aria-hidden="true"></span>
            <div class="step-body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              {s.notice && (
                <p class="notice"><strong>Reimbursement.</strong> {s.notice}</p>
              )}
              {s.details && (<>
              <div class="pills" role="group" aria-label={s.title}>
                {domains.map(d => (
                  <button type="button" class="pill" aria-expanded="false"
                    aria-controls={`step${i + 1}-${d.key}`}>{d.label}</button>
                ))}
              </div>
              {domains.map(d => (
                <div class="pill-panel" id={`step${i + 1}-${d.key}`} data-pill-panel>
                  <span class="pill-panel-label">{d.label}</span>
                  <p>{s.details[d.key]}</p>
                </div>
              ))}
              </>)}
            </div>
          </li>
        ))}
      </ol>

      <p class="helper">Not sure where to start? Book a first appointment and we will look at it together.</p>
    </div>
  </section>

  <section class="practical reveal">
    <div class="container practical-grid">
      <div class="practical-block">
        <h3>Where?</h3>
        <p>
          CAP'S, Centre d'Accompagnement Pédiatrique Spécialisé<br />
          Pl. de la Sainte-Famille 23<br />
          1200 Woluwe-Saint-Lambert
        </p>
      </div>
      <div class="practical-block">
        <h3>Good to know</h3>
        <ul>
          <li>Bring any useful documents to the first appointment: school reports, previous assessments, medical letters.</li>
          <li>
            For fees, <a href={WHATSAPP_URL} target="_blank" rel="noopener">send me a message</a>
            and I will reply with the details.
          </li>
          <li>If you cannot make it, let me know as early as possible so the slot can be freed up.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cta reveal">
    <div class="container">
      <h2>Book a slot</h2>
      <p>
        Appointments are booked online through Rosa, my booking platform, where you can
        see my availability in real time.
      </p>
      <a href={ROSA_URL.en} class="btn-primary" target="_blank" rel="noopener">Book an appointment online</a>
      <p class="cta-alt">
        Would you prefer a home visit?
        <a href="/en/consultation/at-home/">Fill in the request form</a>.
      </p>
    </div>
  </section>

</Layout>


<script>
  // Panels stay visible without JS; with JS they start closed and each
  // step's buttons work as a small toggle group (one panel open at a time).
  document.querySelectorAll<HTMLElement>('[data-pill-panel]').forEach(p => (p.hidden = true));
  document.querySelectorAll<HTMLElement>('.step-body').forEach(step => {
    const pills = step.querySelectorAll<HTMLButtonElement>('.pill');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const open = pill.getAttribute('aria-expanded') === 'true';
        pills.forEach(other => {
          other.setAttribute('aria-expanded', 'false');
          const panel = document.getElementById(other.getAttribute('aria-controls')!);
          if (panel) panel.hidden = true;
        });
        if (!open) {
          pill.setAttribute('aria-expanded', 'true');
          const panel = document.getElementById(pill.getAttribute('aria-controls')!);
          if (panel) panel.hidden = false;
        }
      });
    });
  });
</script>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── Hero ── */
  .page-hero { padding: 5rem 0 3rem; }
  .page-hero .btn-primary { margin-top: 1.25rem; }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.6rem;
  }
  .tagline {
    color: var(--color-text-light);
    font-size: 1.05rem;
    max-width: 620px;
    line-height: 1.7;
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 2.5rem;
  }

  /* ── Timeline ── */
  .journey {
    background: white;
    padding: 4.5rem 0;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 760px;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    gap: 1.25rem;
    padding-bottom: 2.25rem;
  }
  /* Connecting line between markers */
  .step::before {
    content: '';
    position: absolute;
    left: calc(0.55rem - 1px);
    top: 1.9rem;
    bottom: 0;
    width: 2px;
    background: var(--color-tint-lavender);
  }
  .step:last-child { padding-bottom: 0; }
  .step:last-child::before { display: none; }

  .step-marker {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.65rem;
    border-radius: 50%;
    background: var(--color-purple);
    box-shadow: 0 0 0 5px var(--color-tint-lavender);
    position: relative;
    z-index: 1;
  }
  .notice {
    margin-top: 1rem !important;
    padding: 0.9rem 1.15rem;
    border-left: 3px solid var(--color-pink-dark);
    background: #FBF1F2;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.9rem !important;
    color: var(--color-text) !important;
  }
  .notice strong { color: var(--color-pink-dark); }

  .step-loop .step-marker {
    background: var(--color-pink);
    box-shadow: 0 0 0 5px #F3DDE0;
  }
  .step-body h3 {
    font-size: 1.1rem;
    margin: 0.55rem 0 0.5rem;
  }
  .step-body p {
    font-size: 0.95rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin: 0;
  }

  .journey h2 { margin-bottom: 0.75rem; }
  .journey-intro {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin-bottom: 2.5rem;
  }

  .helper {
    margin-top: 2.5rem;
    font-size: 0.92rem;
    color: var(--color-text-light);
    font-style: italic;
  }

  /* ── Domain pills under each step ── */
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .pill {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-tint-lavender);
    background: white;
    color: var(--color-purple-dark);
    cursor: pointer;
    transition: background 180ms, color 180ms, border-color 180ms;
  }
  .pill:hover { border-color: var(--color-purple); }
  .pill[aria-expanded='true'] {
    background: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
  }
  .pill:focus-visible {
    outline: 2px solid var(--color-purple);
    outline-offset: 2px;
  }
  .pill-panel {
    margin-top: 0.85rem;
    padding: 1.1rem 1.35rem;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }
  .pill-panel p {
    font-size: 0.9rem;
    margin: 0;
  }
  .pill-panel .pill-panel-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-purple-dark);
    margin-bottom: 0.4rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .pill { transition: none; }
  }

  /* ── Practical ── */
  .practical {
    padding: 4.5rem 0;
  }
  .practical-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2.5rem;
  }
  .practical-block h3 {
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .practical-block p,
  .practical-block li {
    font-size: 0.92rem;
    color: var(--color-text-light);
    line-height: 1.75;
  }
  .practical-block ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .practical-block li {
    position: relative;
    padding-left: 1.2rem;
  }
  .practical-block li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-purple);
  }
  .practical-block a {
    color: var(--color-purple-dark);
    text-decoration: underline;
  }

  /* ── CTA ── */
  .cta {
    padding: 4rem 0 5rem;
    text-align: center;
  }
  .cta h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.75rem;
  }
  .cta p {
    color: var(--color-text-light);
    max-width: 520px;
    margin: 0 auto 2rem;
    font-size: 0.95rem;
  }
  .cta-alt {
    margin-top: 1.5rem !important;
    font-size: 0.88rem !important;
  }
  .cta-alt a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .container { padding: 0 1.25rem; }
    .page-hero { padding: 3.5rem 0 2rem; }
    .practical-grid { grid-template-columns: 1fr; }
  }
</style>

---
import Layout from '../../../layouts/Layout.astro';
import { HOME_VISIT_FORM, WHATSAPP_NUMBER, isFormConfigured, toEmbedUrl } from '../../../data/booking';

const formUrl = HOME_VISIT_FORM.en;
const configured = isFormConfigured(formUrl);
const embedUrl = toEmbedUrl(formUrl);
---

<Layout title="Home consultation | Ariadna Balsells" lang="en"
  description="Request a speech therapy home visit in Brussels. Fill in the online form and I will get back to you.">

  <section class="page-hero">
    <div class="container">
      <p class="section-label">Consultation</p>
      <h1>At home</h1>

      {/* ⚠️ PLACEHOLDER TEXT: TO BE WRITTEN BY ARI.
          Should cover: area served, when a home visit is appropriate,
          usual response time, and fees / travel costs. */}
      <p class="tagline">
        In some situations it makes more sense to work directly in the child's everyday
        environment. Home consultations are arranged on request and subject to availability.
      </p>
      <p class="tagline">
        Fill in the form below and I will get back to you to confirm whether a home visit
        is possible and to arrange a time.
      </p>
    </div>
  </section>

  <section class="form-section">
    <div class="container">

      {configured ? (
        <div class="form-embed">
          <iframe
            title="Home consultation request form"
            data-consent-src={embedUrl}
            width="100%"
            height="100%"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            loading="lazy">
          </iframe>
          <div class="consent-placeholder form-placeholder">
            <p>
              This form is hosted by Google. It stays hidden until cookies are accepted.
            </p>
            <button type="button" class="consent-btn" onclick="window.openCookieSettings && window.openCookieSettings()">
              Accept cookies
            </button>
            <a href={formUrl} target="_blank" rel="noopener">
              Or open the form in a new tab
            </a>
          </div>
        </div>
      ) : (
        <div class="form-missing">
          <p>
            The online request form is coming very soon. In the meantime, message me
            directly on WhatsApp. It's the fastest way to reach me.
          </p>
          <a href={`https://wa.me/${WHATSAPP_NUMBER}`} class="btn-whatsapp" target="_blank" rel="noopener">
            Message me on WhatsApp
          </a>
        </div>
      )}

      <div class="after-form">
        <p>
          A question before you send your request? The fastest way is
          <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener">WhatsApp</a>.
          I reply much quicker there than by phone.
        </p>
        <p class="small">
          For consultations at the practice, booking is done directly online:
          <a href="/en/consultation/at-the-practice">see consultations at the practice</a>.
        </p>
      </div>

    </div>
  </section>

</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .page-hero { padding: 5rem 0 2.5rem; }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.8rem;
  }
  .tagline {
    color: var(--color-text-light);
    font-size: 1rem;
    max-width: 640px;
    line-height: 1.75;
    margin-bottom: 0.9rem;
  }

  /* ── Embedded Google Form ── */
  .form-section { padding: 1rem 0 4rem; }

  .form-embed {
    position: relative;
    /* Tune once the real form is embedded: too short and it scrolls
       inside the frame, too tall and you get empty space below. */
    height: 1500px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
  }
  .form-embed iframe {
    display: block;
    border: 0;
    width: 100%;
    height: 100%;
  }

  .form-placeholder {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
    padding: 2rem;
  }
  .form-placeholder p {
    font-size: 0.92rem;
    color: var(--color-text-light);
    margin: 0;
    max-width: 340px;
    line-height: 1.65;
  }
  .form-placeholder a {
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: underline;
  }
  .consent-btn {
    padding: 0.6rem 1.4rem;
    background: var(--color-accent);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 0.87rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.2s;
  }
  .consent-btn:hover { background: var(--color-accent-dark); }

  /* Shown only while the form URL has not been pasted into booking.ts */
  .form-missing {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 2.5rem;
    text-align: center;
  }
  .form-missing p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .btn-whatsapp {
    display: inline-block;
    margin-top: 1.25rem;
    padding: 0.7rem 1.5rem;
    background: #25D366;
    color: white !important;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none !important;
  }
  .btn-whatsapp:hover { background: #1ebe5d; }

  /* ── After the form ── */
  .after-form {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .after-form p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.7;
  }
  .after-form .small {
    font-size: 0.83rem;
    margin-top: 0.6rem;
  }
  .after-form a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .container { padding: 0 1.25rem; }
    .page-hero { padding: 3.5rem 0 1.5rem; }
    .form-embed { height: 1750px; }
    .form-missing { padding: 1.75rem; }
  }
</style>

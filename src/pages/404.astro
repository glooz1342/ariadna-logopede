---
import Layout from '../layouts/Layout.astro';

const urlLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'fr';
---

<Layout title="404 | Page introuvable / Not found" lang={urlLang}>
  <section class="not-found">
    <div class="container">
      {/* One h1 per page. Both language blocks are visible and equal, so the
          single heading covers both and is hidden visually rather than
          promoting one language over the other in the document outline. */}
      <h1 class="sr-only">Page introuvable — Page not found</h1>
      <span class="error-code" aria-hidden="true">404</span>

      <div class="messages">
        <div class="message fr">
          <h2>Page introuvable</h2>
          <p>Cette page n'existe pas ou a été déplacée.</p>
          <a href="/fr/" class="btn">Retour à l'accueil</a>
        </div>

        <div class="divider"></div>

        <div class="message en">
          <h2>Page not found</h2>
          <p>This page doesn't exist or has been moved.</p>
          <a href="/en/" class="btn">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .messages {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 2.5rem 2rem;
  }
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .container {
    max-width: 600px;
    width: 100%;
  }

  .error-code {
    display: block;
    font-size: 7rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.15;
    line-height: 1;
    margin-bottom: 2rem;
    font-family: var(--font-serif);
  }

  .messages {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .message h1 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--color-text-dark);
    margin-bottom: 0.5rem;
  }

  .message p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .divider {
    width: 40px;
    height: 1px;
    background: var(--color-accent);
    opacity: 0.3;
    margin: 0 auto;
  }

  .btn {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    padding: 0.65rem 1.75rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.2s;
  }

  .btn:hover {
    background: var(--color-accent-dark);
  }
</style>
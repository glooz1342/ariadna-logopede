---
// Spanish translation of src/pages/fr/consultation/a-domicile.astro (October 2026).
// When the French page changes, update this one too.
import Layout from '../../../layouts/Layout.astro';
import { HOME_VISIT_FORM, WHATSAPP_URL, isFormConfigured, toEmbedUrl } from '../../../data/booking';

const formUrl = HOME_VISIT_FORM.es;
const configured = isFormConfigured(formUrl);
const embedUrl = toEmbedUrl(formUrl);
---

<Layout title="Consulta a domicilio | Ariadna Balsells" lang="es"
  description="Solicitud de consulta de logopedia a domicilio en Bruselas. Rellene el formulario en línea y me pondré en contacto con usted.">

  <section class="page-hero soft-band soft-band-top grain">
    <div class="container">
      <p class="section-label">Consulta</p>
      <h1>A domicilio</h1>

      {/* ⚠️ TEXTE PROVISOIRE : À RÉDIGER PAR ARI.
          Doit préciser : zone géographique couverte, dans quels cas le domicile
          est indiqué, délai de réponse habituel, et tarif / frais de déplacement. */}
      <p class="tagline">
        En algunas situaciones, es más adecuado trabajar directamente en el entorno
        cotidiano del niño. Las consultas a domicilio se realizan bajo petición y según
        mi disponibilidad.
      </p>
      <p class="tagline">
        Rellene el formulario de abajo: me pondré en contacto con usted para confirmar
        si es posible un acompañamiento a domicilio y acordar un horario.
      </p>
    </div>
  </section>

  <section class="form-section reveal">
    <div class="container">

      {configured ? (
        <div class="form-embed">
          <iframe
            title="Formulario de solicitud de consulta a domicilio"
            data-consent-src={embedUrl}
            width="100%"
            height="100%"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            loading="lazy">
          </iframe>
          <div class="consent-placeholder form-placeholder">
            <p>
              Este formulario está alojado en Google. Permanece oculto mientras no se
              acepten las cookies.
            </p>
            <button type="button" class="consent-btn" onclick="window.openCookieSettings && window.openCookieSettings()">
              Aceptar las cookies
            </button>
            <a href={formUrl} target="_blank" rel="noopener">
              O abrir el formulario en una pestaña nueva
            </a>
          </div>
        </div>
      ) : (
        <div class="form-missing">
          <p>
            El formulario de solicitud en línea estará disponible muy pronto. Mientras tanto,
            escríbame directamente por WhatsApp. Es lo más rápido.
          </p>
          <a href={WHATSAPP_URL} class="btn-whatsapp" target="_blank" rel="noopener">
            Escribir por WhatsApp
          </a>
        </div>
      )}

      <div class="after-form">
        <p>
          ¿Tiene alguna pregunta antes de enviar su solicitud? Lo más rápido sigue siendo
          <a href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>.
          Respondo mucho antes por ahí que por teléfono.
        </p>
        <p class="small">
          Para una consulta en el centro, la reserva se hace directamente en línea:
          <a href="/es/consulta/en-el-centro/">ver las consultas en el centro</a>.
        </p>
      </div>

    </div>
  </section>

</Layout>

<style>
  /* Until the request form exists, the fallback message IS the page, so it
     gets the same card treatment as every other primary block on the site
     rather than sitting as loose text on the ground. */
  .form-missing,
  .after-form {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 2rem;
    max-width: 1100px;
    margin: 0 auto 1.5rem;
  }
  .form-embed {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .page-hero { padding: 5rem 0 2.5rem; }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.8rem;
  }
  .tagline {
    color: var(--color-text-light);
    font-size: 1rem;
    max-width: 640px;
    line-height: 1.75;
    margin-bottom: 0.9rem;
  }

  /* ── Embedded Google Form ── */
  .form-section { padding: 1rem 0 4rem; }

  .form-embed {
    position: relative;
    /* Tune once the real form is embedded: too short and it scrolls
       inside the frame, too tall and you get empty space below. */
    height: 1500px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
  }
  .form-embed iframe {
    display: block;
    border: 0;
    width: 100%;
    height: 100%;
  }

  .form-placeholder {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
    padding: 2rem;
  }
  .form-placeholder p {
    font-size: 0.92rem;
    color: var(--color-text-light);
    margin: 0;
    max-width: 340px;
    line-height: 1.65;
  }
  .form-placeholder a {
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Shown only while the form URL has not been pasted into booking.ts */
  .form-missing {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 2.5rem;
    text-align: center;
  }
  .form-missing p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── After the form ── */
  .after-form {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .after-form p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.7;
  }
  .after-form .small {
    font-size: 0.83rem;
    margin-top: 0.6rem;
  }
  .after-form a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .container { padding: 0 1.25rem; }
    .page-hero { padding: 3.5rem 0 1.5rem; }
    .form-embed { height: 1750px; }
    .form-missing { padding: 1.75rem; }
  }
</style>

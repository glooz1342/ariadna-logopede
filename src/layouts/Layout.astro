---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  lang: 'fr' | 'en';
  description?: string;
}

const { title, lang, description } = Astro.props;

const defaultDescription = {
  fr: "Ariadna Balsells, logopède à Woluwe-Saint-Lambert, Bruxelles. Consultations pour enfants et adultes : langage, parole, lecture et écriture.",
  en: "Ariadna Balsells, speech therapist in Woluwe-Saint-Lambert, Brussels. Consultations for children and adults: language, speech, reading and writing."
};

const metaDescription = description ?? defaultDescription[lang];
const siteUrl = "https://ariadna-logopede.pages.dev";
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_BE' : 'en_GB'} />
    <meta property="og:site_name" content="Ariadna Balsells — Logopède" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #FAFAF8;
    --color-text: #2C2C2C;
    --color-text-light: #6B6B6B;
    --color-accent: #7B9E87;
    --color-accent-dark: #5A7A66;
    --color-border: #E8E4DF;
    --font-heading: 'Lora', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: 1.6;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    line-height: 1.3;
  }

  main {
    min-height: calc(100vh - 72px - 120px);
  }

  a { color: inherit; text-decoration: none; }
</style>
---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  lang: 'fr' | 'en';
  description?: string;
}

const { title, lang, description } = Astro.props;

const defaultDescription = {
  fr: "Ariadna Balsells, logopède à Woluwe-Saint-Lambert, Bruxelles. J'accompagne les enfants : langage, communication, alimentation, apprentissage des mathématiques.",
  en: "Ariadna Balsells, speech therapist in Woluwe-Saint-Lambert, Brussels. I support children with language, communication, feeding and mathematical learning."
};

const metaDescription = description ?? defaultDescription[lang];
const siteUrl = "https://ariadna-logopede.be";
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;

// ── FR ↔ EN counterpart pages ──
// Used for hreflang alternates and the header language switcher,
// so switching language keeps you on the same page.
const pathPairs: [string, string][] = [
  ['/fr', '/en'],
  ['/fr/apropos', '/en/about'],
  ['/fr/contact', '/en/contact'],
  ['/fr/galerie', '/en/gallery'],
  ['/fr/cookies', '/en/cookies'],
  ['/fr/consultation/en-cabinet', '/en/consultation/at-the-practice'],
  ['/fr/consultation/a-domicile', '/en/consultation/at-home'],
];
const pathMap: Record<string, string> = {};
for (const [fr, en] of pathPairs) {
  pathMap[fr] = en;
  pathMap[en] = fr;
}
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const altPath = pathMap[currentPath] ?? (lang === 'fr' ? '/en' : '/fr');
const frPath = lang === 'fr' ? currentPath : altPath;
const enPath = lang === 'en' ? currentPath : altPath;

// ── Structured data (local SEO) ──
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "name": "Ariadna Balsells, Logopède",
  "description": metaDescription,
  "url": `${siteUrl}/fr/`,
  "image": `${siteUrl}/Ari.jpeg`,
  "telephone": "+32474052583",
  "email": "ariadna.logopede@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Place de la Sainte-Famille 23",
    "postalCode": "1200",
    "addressLocality": "Woluwe-Saint-Lambert",
    "addressRegion": "Bruxelles",
    "addressCountry": "BE"
  },
  // Corroborating profiles. Google uses sameAs to tie this site to the
  // same real-world entity as the Instagram and Rosa pages, which is
  // what a search for her name needs in order to resolve.
  "sameAs": [
    "https://www.instagram.com/logopede.ari/",
    "https://www.rosa.be/fr/hp/ariadna-balsells-mencaroni-poiani/",
    "https://be.linkedin.com/in/ariadna-balsells-a46b11172"
  ],
  "areaServed": {
    "@type": "City",
    "name": "Bruxelles"
  },
  "availableLanguage": ["fr", "en", "es"],
  // Names the practitioner as a Person, distinct from the practice, so
  // a query on her name has an entity to match.
  "founder": {
    "@type": "Person",
    "name": "Ariadna Balsells",
    "jobTitle": "Logopède",
    "url": `${siteUrl}/fr/apropos/`,
    "sameAs": [
      "https://www.instagram.com/logopede.ari/",
      "https://be.linkedin.com/in/ariadna-balsells-a46b11172"
    ]
  }
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Language alternates -->
    <link rel="alternate" hreflang="fr-BE" href={`${siteUrl}${frPath}/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${frPath}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_BE' : 'en_GB'} />
    <meta property="og:site_name" content="Ariadna Balsells, Logopède" />
    <meta property="og:image" content={`${siteUrl}/Ari.jpeg`} />
    <meta name="twitter:card" content="summary" />

    <!-- Structured data for local search -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F9ECE3" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header lang={lang} altHref={altPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #F9ECE3;
    --color-surface: #FFFFFF;
    --color-text: #2C2C2C;
    --color-text-light: #5E5E5E;
    --color-accent: #2C2C2C;
    --color-accent-dark: #1A1A1A;
    --color-border: #E5D8CD;
    --color-purple: #7E6E9C;
    --color-purple-dark: #6A5B87;
    --color-pink: #D99BA4;
    --color-pink-dark: #C8848E;
    --color-tint-lavender: #D2C7E5;
    --color-tint-mint: #D3EADA;
    --color-tint-blue: #C7D8E8;
    --font-heading: 'Lora', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: 1.6;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    line-height: 1.3;
  }

  main {
    min-height: calc(100vh - 72px - 120px);
  }

  a { color: inherit; text-decoration: none; }
</style>
---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  lang: 'fr' | 'en';
  description?: string;
}

const { title, lang, description } = Astro.props;

const defaultDescription = {
  fr: "Ariadna Balsells, logopède à Woluwe-Saint-Lambert, Bruxelles. Consultations pour enfants et adultes : langage, parole, lecture et écriture.",
  en: "Ariadna Balsells, speech therapist in Woluwe-Saint-Lambert, Brussels. Consultations for children and adults: language, speech, reading and writing."
};

const metaDescription = description ?? defaultDescription[lang];
const siteUrl = "https://ariadna-logopede.be";
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;

// ── FR ↔ EN counterpart pages ──
// Used for hreflang alternates and the header language switcher,
// so switching language keeps you on the same page.
const pathPairs: [string, string][] = [
  ['/fr', '/en'],
  ['/fr/apropos', '/en/about'],
  ['/fr/contact', '/en/contact'],
  ['/fr/galerie', '/en/gallery'],
  ['/fr/cookies', '/en/cookies'],
];
const pathMap: Record<string, string> = {};
for (const [fr, en] of pathPairs) {
  pathMap[fr] = en;
  pathMap[en] = fr;
}
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const altPath = pathMap[currentPath] ?? (lang === 'fr' ? '/en' : '/fr');
const frPath = lang === 'fr' ? currentPath : altPath;
const enPath = lang === 'en' ? currentPath : altPath;

// ── Structured data (local SEO) ──
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "name": "Ariadna Balsells — Logopède",
  "description": metaDescription,
  "url": `${siteUrl}/fr/`,
  "image": `${siteUrl}/Ari.jpeg`,
  "telephone": "+32474052583",
  "email": "ariadna.logopede@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Place de la Sainte-Famille 23",
    "postalCode": "1200",
    "addressLocality": "Woluwe-Saint-Lambert",
    "addressRegion": "Bruxelles",
    "addressCountry": "BE"
  }
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Language alternates -->
    <link rel="alternate" hreflang="fr-BE" href={`${siteUrl}${frPath}/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${frPath}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_BE' : 'en_GB'} />
    <meta property="og:site_name" content="Ariadna Balsells — Logopède" />
    <meta property="og:image" content={`${siteUrl}/Ari.jpeg`} />
    <meta name="twitter:card" content="summary" />

    <!-- Structured data for local search -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#5A7A66" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header lang={lang} altHref={altPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #FAFAF8;
    --color-text: #2C2C2C;
    --color-text-light: #6B6B6B;
    --color-accent: #7B9E87;
    --color-accent-dark: #5A7A66;
    --color-border: #E8E4DF;
    --font-heading: 'Lora', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: 1.6;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    line-height: 1.3;
  }

  main {
    min-height: calc(100vh - 72px - 120px);
  }

  a { color: inherit; text-decoration: none; }
</style>
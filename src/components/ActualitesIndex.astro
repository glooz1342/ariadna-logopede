---
import {
  getEvents, getArticles, indexPath, slugOf, formatRange, formatDate, t,
  type Lang,
} from '../data/actualites';

interface Props { lang: Lang }
const { lang } = Astro.props as Props;

const { upcoming } = await getEvents(lang);
const articles = await getArticles(lang);
const s = t[lang];
const base = indexPath[lang];
const href = (id: string) => `${base}/${slugOf(id)}/`;
---

<section class="page-hero soft-band soft-band-top grain">
  <div class="container">
    <p class="eyebrow section-label">{s.eyebrow}</p>
    <h1>{s.h1}</h1>
    <p class="tagline">{s.subtitle}</p>
  </div>
</section>

{/* The events block is omitted entirely when nothing is coming up, rather
    than rendering an empty-state box. Most of the year there is no stage
    planned, and a permanent "no events" panel makes the page look dead. */}
{upcoming.length > 0 && (
  <section class="events reveal">
    <div class="container">
      <h2 class="section-heading">{s.upcoming}</h2>
      <ul class="event-list">
        {upcoming.map(e => (
          <li class="event-card">
            <div class="event-date" aria-hidden="true">
              <span class="day">{e.data.startDate.getDate()}</span>
              <span class="month">
                {e.data.startDate.toLocaleDateString(
                  lang === 'fr' ? 'fr-BE' : 'en-GB', { month: 'short' })}
              </span>
            </div>
            <div class="event-body">
              <h3><a href={href(e.id)}>{e.data.title}</a></h3>
              <p class="event-meta">
                {formatRange(e.data.startDate, e.data.endDate, lang)}
                {e.data.time && <span> · {e.data.time}</span>}
                {e.data.location && <span> · {e.data.location}</span>}
              </p>
              <p class="event-summary">{e.data.summary}</p>
              <a href={href(e.id)} class="btn-outline">{s.readMore}</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<section class="articles reveal">
  <div class="container">
    {upcoming.length > 0 && <h2 class="section-heading">{s.articles}</h2>}

    {articles.length === 0 && upcoming.length === 0 ? (
      <div class="empty"><p>{s.empty}</p></div>
    ) : (
      <div class="article-grid">
        {articles.map(a => (
          <article class="article-card">
            {a.data.cover && (
              <a href={href(a.id)} class="thumb">
                <img src={a.data.cover} alt={a.data.coverAlt ?? ''} loading="lazy" />
              </a>
            )}
            <div class="article-body">
              <p class="article-date">{formatDate(a.data.date, lang)}</p>
              <h3><a href={href(a.id)}>{a.data.title}</a></h3>
              <p class="article-summary">{a.data.summary}</p>
              <a href={href(a.id)} class="read-more">{s.readMore}</a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }

  .page-hero { padding: 5rem 0 3rem; }
  .page-hero h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; }
  .tagline { color: var(--color-text-light); font-size: 1.05rem; max-width: 60ch; }

  .section-heading {
    font-size: 1.5rem;
    margin-bottom: 1.75rem;
  }

  /* ── Events ── */
  .events { padding: 1rem 0 3rem; }
  .event-list { list-style: none; display: grid; gap: 1.25rem; }
  .event-card {
    display: flex;
    gap: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.75rem;
  }
  .event-date {
    flex: 0 0 68px;
    text-align: center;
    align-self: flex-start;
    background: var(--color-tint-lavender);
    border-radius: 12px;
    padding: 0.6rem 0;
  }
  .event-date .day {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    line-height: 1.1;
  }
  .event-date .month {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-light);
  }
  .event-body h3 { font-size: 1.35rem; margin-bottom: 0.35rem; }
  .event-body h3 a:hover { color: var(--color-purple); }
  .event-meta { color: var(--color-text-light); font-size: 0.9rem; margin-bottom: 0.75rem; }
  .event-summary { margin-bottom: 1.1rem; }

  /* ── Articles ── */
  .articles { padding: 1rem 0 6rem; }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }
  .article-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .thumb { display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--color-border); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .thumb:hover img { transform: scale(1.04); }
  .article-body { padding: 1.5rem; display: flex; flex-direction: column; flex: 1; }
  .article-date { font-size: 0.8rem; color: var(--color-text-light); margin-bottom: 0.4rem; }
  .article-body h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .article-body h3 a:hover { color: var(--color-purple); }
  .article-summary { font-size: 0.95rem; color: var(--color-text-light); margin-bottom: 1rem; }
  .read-more { margin-top: auto; font-size: 0.9rem; color: var(--color-purple); font-weight: 500; }
  .read-more:hover { text-decoration: underline; }

  .empty {
    text-align: center;
    padding: 6rem 2rem;
    border: 2px dashed var(--color-border);
    border-radius: 16px;
    color: var(--color-text-light);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .page-hero { padding: 3rem 0 2rem; }
    .event-card { flex-direction: column; gap: 1rem; padding: 1.5rem; }
    .event-date { flex: none; width: 68px; }
  }
</style>

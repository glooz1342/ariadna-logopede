---
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props as Props;

// ── Google Analytics ──
// TODO: replace the ID below with the real GA4 Measurement ID if it ever changes
// (Google Analytics → Admin → Data Streams → your stream).
const GA_MEASUREMENT_ID = "G-YBZBCZ3R3W";

const t = {
  fr: {
    text: "Ce site utilise des cookies pour mesurer son audience et afficher une carte. Vous pouvez accepter ou refuser les cookies non essentiels.",
    accept: "Accepter",
    reject: "Refuser",
    policy: "En savoir plus",
    policyHref: "/fr/cookies/",
  },
  en: {
    text: "This site uses cookies to measure its audience and display a map. You can accept or decline non-essential cookies.",
    accept: "Accept",
    reject: "Decline",
    policy: "Learn more",
    policyHref: "/en/cookies/",
  },
};
const c = t[lang];
---

<div id="cookie-banner" class="cookie-banner" data-ga-id={GA_MEASUREMENT_ID}>
  <p class="cookie-text">
    {c.text} <a href={c.policyHref}>{c.policy}</a>
  </p>
  <div class="cookie-actions">
    <button id="cookie-reject" class="cookie-btn cookie-btn-secondary">{c.reject}</button>
    <button id="cookie-accept" class="cookie-btn cookie-btn-primary">{c.accept}</button>
  </div>
</div>

<script is:inline data-cfasync="false">
  (function () {
    var banner = document.getElementById("cookie-banner");
    var GA_MEASUREMENT_ID = banner ? banner.getAttribute("data-ga-id") : "";

    function getConsent() {
      var m = document.cookie.match(/(?:^|; )cookie_consent=([^;]+)/);
      return m ? m[1] : null;
    }
    function setConsent(value) {
      var sixMonths = 60 * 60 * 24 * 182;
      document.cookie = "cookie_consent=" + value + "; path=/; max-age=" + sixMonths + "; SameSite=Lax";
    }

    function showBanner() { if (banner) banner.classList.add("show"); }
    function hideBanner() { if (banner) banner.classList.remove("show"); }

    function loadAnalytics() {
      if (!GA_MEASUREMENT_ID || GA_MEASUREMENT_ID.indexOf("XXXX") !== -1) return;
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_MEASUREMENT_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", GA_MEASUREMENT_ID);
    }

    function activateEmbeds() {
      var gated = document.querySelectorAll("[data-consent-src]");
      for (var i = 0; i < gated.length; i++) {
        gated[i].setAttribute("src", gated[i].getAttribute("data-consent-src"));
        gated[i].removeAttribute("data-consent-src");
      }
      var ph = document.querySelectorAll(".consent-placeholder");
      for (var j = 0; j < ph.length; j++) { ph[j].style.display = "none"; }
    }

    function grantAll() {
      setConsent("granted");
      hideBanner();
      loadAnalytics();
      activateEmbeds();
    }
    function denyAll() {
      setConsent("denied");
      hideBanner();
    }

    // Allow the policy page / map placeholder to re-open the banner
    window.openCookieSettings = showBanner;

    var consent = getConsent();
    if (consent === "granted") {
      loadAnalytics();
      activateEmbeds();
    } else if (consent !== "denied") {
      showBanner();
    }

    var acceptBtn = document.getElementById("cookie-accept");
    var rejectBtn = document.getElementById("cookie-reject");
    if (acceptBtn) acceptBtn.addEventListener("click", grantAll);
    if (rejectBtn) rejectBtn.addEventListener("click", denyAll);
  })();
</script>

<style>
  .cookie-banner {
    display: none;
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    max-width: 720px;
    margin: 0 auto;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.14);
    padding: 1.25rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    z-index: 1000;
  }
  .cookie-banner.show { display: flex; }
  .cookie-text {
    font-size: 0.85rem;
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }
  .cookie-text a { color: var(--color-accent); text-decoration: underline; }
  .cookie-actions { display: flex; gap: 0.6rem; flex-shrink: 0; }
  .cookie-btn {
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .cookie-btn-primary {
    background: var(--color-accent);
    color: white;
    border: 1px solid var(--color-accent);
  }
  .cookie-btn-primary:hover { background: var(--color-accent-dark); border-color: var(--color-accent-dark); }
  .cookie-btn-secondary {
    background: white;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .cookie-btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }

  @media (max-width: 600px) {
    .cookie-banner.show { flex-direction: column; align-items: stretch; }
    .cookie-banner { gap: 1rem; padding: 1.1rem 1.2rem; }
    .cookie-actions { justify-content: stretch; }
    .cookie-btn { flex: 1; }
  }
</style>

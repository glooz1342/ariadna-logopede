---
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props as Props;

// ── Google Analytics ──
// TODO: replace G-XXXXXXXXXX below with the real GA4 Measurement ID once the
// property is created (Google Analytics → Admin → Data Streams → your stream).
// Until a real ID is set, analytics simply won't load, but the banner and the
// map still work correctly.
const GA_MEASUREMENT_ID = "G-XXXXXXXXXX";

const t = {
  fr: {
    text: "Ce site utilise des cookies pour mesurer son audience et afficher une carte. Vous pouvez accepter ou refuser les cookies non essentiels.",
    accept: "Accepter",
    reject: "Refuser",
    policy: "En savoir plus",
    policyHref: "/fr/cookies",
  },
  en: {
    text: "This site uses cookies to measure its audience and display a map. You can accept or decline non-essential cookies.",
    accept: "Accept",
    reject: "Decline",
    policy: "Learn more",
    policyHref: "/en/cookies",
  },
};
const c = t[lang];
---

<div id="cookie-banner" class="cookie-banner" hidden>
  <p class="cookie-text">
    {c.text} <a href={c.policyHref}>{c.policy}</a>
  </p>
  <div class="cookie-actions">
    <button id="cookie-reject" class="cookie-btn cookie-btn-secondary">{c.reject}</button>
    <button id="cookie-accept" class="cookie-btn cookie-btn-primary">{c.accept}</button>
  </div>
</div>

<script define:vars={{ GA_MEASUREMENT_ID }}>
  (function () {
    const CONSENT_KEY = "cookie_consent";
    const banner = document.getElementById("cookie-banner");

    function getConsent() {
      const m = document.cookie.match(/(?:^|; )cookie_consent=([^;]+)/);
      return m ? m[1] : null;
    }
    function setConsent(value) {
      const sixMonths = 60 * 60 * 24 * 182;
      document.cookie =
        CONSENT_KEY + "=" + value + "; path=/; max-age=" + sixMonths + "; SameSite=Lax";
    }

    function loadAnalytics() {
      // Don't load until a real GA4 ID is configured
      if (!GA_MEASUREMENT_ID || GA_MEASUREMENT_ID.indexOf("XXXX") !== -1) return;
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      const s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_MEASUREMENT_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", GA_MEASUREMENT_ID);
    }

    function activateEmbeds() {
      document.querySelectorAll("[data-consent-src]").forEach(function (el) {
        el.setAttribute("src", el.getAttribute("data-consent-src"));
        el.removeAttribute("data-consent-src");
      });
      document.querySelectorAll(".consent-placeholder").forEach(function (el) {
        el.style.display = "none";
      });
    }

    function grantAll() {
      setConsent("granted");
      if (banner) banner.hidden = true;
      loadAnalytics();
      activateEmbeds();
    }
    function denyAll() {
      setConsent("denied");
      if (banner) banner.hidden = true;
    }

    // Let the policy page / footer re-open the banner to change preferences
    window.openCookieSettings = function () {
      if (banner) banner.hidden = false;
    };

    const consent = getConsent();
    if (consent === "granted") {
      loadAnalytics();
      activateEmbeds();
    } else if (consent !== "denied") {
      if (banner) banner.hidden = false;
    }

    document.getElementById("cookie-accept")?.addEventListener("click", grantAll);
    document.getElementById("cookie-reject")?.addEventListener("click", denyAll);
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    max-width: 720px;
    margin: 0 auto;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.14);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    z-index: 1000;
  }
  .cookie-text {
    font-size: 0.85rem;
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }
  .cookie-text a {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .cookie-actions {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .cookie-btn {
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .cookie-btn-primary {
    background: var(--color-accent);
    color: white;
    border: 1px solid var(--color-accent);
  }
  .cookie-btn-primary:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
  }
  .cookie-btn-secondary {
    background: white;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .cookie-btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .cookie-banner {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1.1rem 1.2rem;
    }
    .cookie-actions {
      justify-content: stretch;
    }
    .cookie-btn {
      flex: 1;
    }
  }
</style>

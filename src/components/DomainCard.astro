---
/**
 * One domaine d'intervention, rendered as a full-bleed tinted field.
 *
 * Replaces the previous white rounded card. Three identical cards stacked
 * on white was the most template-looking part of the site; giving each
 * domain a band of its own colour makes the page read as three rooms
 * rather than three rows of a grid.
 *
 * The reading order is inverted from the old card. What a parent can
 * observe at home (`observations`) is now the visible content, and the
 * clinical vocabulary (`terms`, `assoc`) sits behind a disclosure. A
 * parent should be able to recognise their child before meeting the word
 * "morphosyntaxe". No string is rewritten: `headings[1]` labels the
 * visible list and `headings[0]` labels the disclosure, both exactly as
 * Ari wrote them.
 *
 * Two rendering defects from 79b2b3e are fixed structurally rather than
 * with new copy:
 *  - `assoc.primary` entries carry no `desc`, so they rendered as empty
 *    boxes. They are now chips, a form that expects no description.
 *  - `assoc.conditions` entries without a `desc` sat in a card grid
 *    beside siblings that had one, and read as broken. The grid is now a
 *    definition list, where a missing description is a quiet gap.
 *
 * `intro`, `note` and each observation accept inline <strong>, so they
 * are rendered with set:html. Only ever pass hard-coded copy from this
 * repo.
 */
import DomainIcon from './DomainIcon.astro';
import type { IconName } from './DomainIcon.astro';

export interface DomainTerm {
  /** Clinical name, e.g. "Trouble développemental du langage". */
  term: string;
  /** Small print under the term, e.g. an acronym. */
  sub?: string;
}

export interface AssocCondition {
  /** Condition name, e.g. "Trisomie 21". */
  title: string;
  /** One line on how it is accompanied. */
  desc?: string;
  /** Highlights the row; use for the most common condition. */
  featured?: boolean;
}

export interface Props {
  title: string;
  /** Line mark shown before the title. */
  icon: IconName;
  /** May contain <strong>. */
  intro: string;
  /** `[0]` labels the disclosure, `[1]` labels the visible list. */
  headings: [string, string];
  /** Clinical terms. Behind the disclosure. */
  terms: DomainTerm[];
  /** Parent-facing observations. The visible content of the field.
   *  May contain <strong>, so rendered with set:html. */
  observations: string[];
  /** Optional line above the observations. */
  observationsIntro?: string;
  /** `primary` are the domain's own diagnoses, rendered as chips. */
  assoc?: { primary?: AssocCondition[]; lead: string; conditions: AssocCondition[] };
  /** Closing note. May contain <strong>. */
  note?: string;
  /** Accent tint for this domain. One per field. */
  tint?: 'lavender' | 'mint' | 'blue';
  /** Moves the title column to the right. Alternated down the page. */
  flip?: boolean;
}

const {
  title, icon, intro, headings, terms, observations, observationsIntro, assoc, note,
  tint = 'lavender', flip = false,
} = Astro.props;
---

<article class={`domain tint-${tint}${flip ? ' flip' : ''}`}>
  <div class="wrap">

    <div class="mark">
      <span class="icon-chip"><DomainIcon name={icon} /></span>
      <h3>{title}</h3>
    </div>

    <div class="body">
      <p class="lede" set:html={intro} />

      <p class="signs-head">{headings[1]}</p>
      {observationsIntro && <p class="signs-intro">{observationsIntro}</p>}
      <ul class="signs">
        {observations.map(o => <li set:html={o} />)}
      </ul>

      <details class="more">
        <summary>
          <span class="more-label">{headings[0]}</span>
          <span class="chev" aria-hidden="true"></span>
        </summary>

        <div class="panel">
          <ul class="terms">
            {terms.map(t => (
              <li>
                <span class="term">{t.term}</span>
                {t.sub && <span class="sub">{t.sub}</span>}
              </li>
            ))}
          </ul>

          {assoc?.primary && assoc.primary.length > 0 && (
            <ul class="chips">
              {assoc.primary.map(c => <li>{c.title}</li>)}
            </ul>
          )}

          {assoc && (
            <div class="assoc">
              <p class="assoc-lead">{assoc.lead}</p>
              <dl class="conds">
                {assoc.conditions.map(c => (
                  <>
                    <dt class={c.featured ? 'featured' : undefined}>{c.title}</dt>
                    <dd>{c.desc}</dd>
                  </>
                ))}
              </dl>
            </div>
          )}

          {note && <p class="note" set:html={note} />}
        </div>
      </details>
    </div>

  </div>
</article>

<style>
  /* ── The field ──
     Each domain is a full-width band in its own tint, washed well back so
     body copy stays comfortable on it. --edge is the same hue pushed
     darker, used for rules and bullets. */
  .domain {
    --tint: var(--color-tint-lavender);
    --field: #EFECF4;
    --field: color-mix(in srgb, var(--color-tint-lavender) 38%, white);
    --edge: #A99BC4;
    --edge: color-mix(in srgb, var(--color-tint-lavender) 72%, #2C2C2C 16%);

    background: var(--color-surface);
    padding: 4rem 0;
    /* The bands are now contained cards on the page ground rather than
       full-bleed stripes: same alternating structure, softer edges. */
    max-width: 1240px;
    margin: 0 auto 2rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }
  .domain.tint-mint {
    --tint: var(--color-tint-mint);
    --field: color-mix(in srgb, var(--color-tint-mint) 38%, white);
    --edge: color-mix(in srgb, var(--color-tint-mint) 72%, #2C2C2C 16%);
  }
  .domain.tint-blue {
    --tint: var(--color-tint-blue);
    --field: color-mix(in srgb, var(--color-tint-blue) 38%, white);
    --edge: color-mix(in srgb, var(--color-tint-blue) 72%, #2C2C2C 16%);
  }

  /* On a white card the tint has to live somewhere: it moves onto the icon,
     which keeps each domain colour-coded without washing the body copy. */
  .icon-chip {
    display: inline-grid;
    place-content: center;
    width: 56px; height: 56px;
    border-radius: var(--radius-sm);
    background: var(--field);
    margin-bottom: 1rem;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }
  /* Alternating the title column down the page is what keeps three fields
     from reading as three rows of one table. */
  .domain.flip .wrap { grid-template-columns: minmax(0, 1fr) minmax(0, 15rem); }
  .domain.flip .mark { order: 2; }

  /* ── Title column ── */
  .mark { color: var(--edge); }
  .mark h3 {
    margin: 0.9rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text);
    text-wrap: balance;
  }

  /* ── Visible content ── */
  .lede {
    margin: 0 0 2rem;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--color-text-light);
    max-width: 62ch;
  }
  .lede :global(strong) { font-weight: 600; color: var(--color-text); }

  .signs-head {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--color-text);
    margin: 0 0 0.4rem;
  }
  .signs-intro {
    margin: 0 0 1rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--color-text-light);
    max-width: 60ch;
  }
  ul.signs { list-style: none; margin: 0; padding: 0; max-width: 60ch; }
  ul.signs li {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: 0.7rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text);
  }
  ul.signs li :global(strong) { font-weight: 600; }
  ul.signs li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--edge);
  }

  /* ── Disclosure ── */
  .more { margin-top: 2rem; }
  .more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--color-text);
    border-bottom: 1px solid var(--edge);
    padding-bottom: 0.3rem;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary:focus-visible { outline: 2px solid var(--color-purple); outline-offset: 4px; }

  .chev {
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.8px solid var(--edge);
    border-bottom: 1.8px solid var(--edge);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .more[open] .chev { transform: rotate(-135deg) translate(-2px, -2px); }

  /* ::details-content animates to `auto` thanks to interpolate-size,
     declared once in Layout.astro. Browsers without support open
     instantly, which is the previous behaviour. */
  .more::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 360ms cubic-bezier(0.32, 0.72, 0, 1),
                content-visibility 360ms allow-discrete;
  }
  .more[open]::details-content { block-size: auto; }

  @media (prefers-reduced-motion: reduce) {
    .more::details-content { transition: none; }
    .chev { transition: none; }
  }

  /* The opened panel sits on white so it reads as a distinct layer over
     the tinted field. */
  .panel {
    background: var(--color-surface);
    border-radius: 14px;
    padding: 1.9rem 2rem;
    margin-top: 1.4rem;
  }

  ul.terms { list-style: none; margin: 0; padding: 0; }
  ul.terms li {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  ul.terms li:first-child { padding-top: 0; }
  ul.terms li:last-child { border-bottom: none; }
  .term {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-text);
  }
  .sub {
    display: block;
    margin-top: 2px;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--color-text-light);
  }

  /* ── Primary diagnoses ──
     Named conditions with no accompanying line. Chips expect no
     description, so nothing looks missing. */
  ul.chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.2rem 0 0;
    padding: 0;
  }
  ul.chips li {
    border: 1px solid var(--tint);
    background: color-mix(in srgb, var(--tint) 30%, white);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-text);
  }

  /* ── Associated conditions ──
     A definition list, not a card grid: a condition with no description
     leaves an empty cell rather than an empty box. */
  .assoc { margin-top: 1.8rem; }
  .assoc-lead {
    margin: 0 0 1rem;
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 62ch;
  }
  .conds {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    column-gap: 2rem;
    margin: 0;
  }
  .conds dt {
    padding: 0.75rem 0 0.75rem 0.85rem;
    border-top: 1px solid var(--color-border);
    border-left: 2px solid transparent;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .conds dt.featured { border-left-color: var(--edge); }
  .conds dd {
    margin: 0;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-text-light);
  }

  /* ── Closing note ── */
  .note {
    margin: 1.8rem 0 0;
    background: color-mix(in srgb, var(--tint) 30%, white);
    border-radius: 12px;
    padding: 1.05rem 1.2rem;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--color-text);
  }
  .note :global(strong) { font-weight: 600; }

  @media (max-width: 900px) {
    .domain { padding: 3rem 0; }
    .wrap,
    .domain.flip .wrap { grid-template-columns: 1fr; gap: 1.5rem; }
    .domain.flip .mark { order: 0; }
    .mark { display: flex; align-items: center; gap: 0.85rem; }
    .mark h3 { margin: 0; font-size: 1.4rem; }
    .panel { padding: 1.4rem 1.25rem; }
    .conds { grid-template-columns: 1fr; column-gap: 0; }
    .conds dd { padding-top: 0; border-top: none; }
    .conds dt { padding-bottom: 0.4rem; }
    .conds dd:empty { display: none; }
  }
</style>

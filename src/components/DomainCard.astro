---
/**
 * "Encadré" card for the Domaines d'intervention section.
 *
 * Structure follows Ari's mockup exactly: a shared two-column header,
 * the clinical terms on the left, a separate list of plain-language
 * observations on the right (the two columns are not paired row by
 * row), then the associated-condition cards and an optional closing
 * note.
 *
 * `intro` and `note` accept inline <strong> tags, so they are rendered
 * with set:html. Only ever pass hard-coded copy from this repo.
 */
export interface DomainTerm {
  /** Clinical name, e.g. "Trouble développemental du langage". */
  term: string;
  /** Small print under the term, e.g. an acronym. */
  sub?: string;
}

export interface AssocCondition {
  /** Condition name, e.g. "Trisomie 21". */
  title: string;
  /** One line on how it is accompanied. */
  desc?: string;
  /** Highlights the card; use for the most common condition. */
  featured?: boolean;
}

export interface Props {
  title: string;
  /** Emoji shown before the title, as in Ari's mockup. */
  icon?: string;
  /** May contain <strong>. */
  intro: string;
  /** Column headings above the two lists. */
  headings: [string, string];
  /** Left column: clinical terms. */
  terms: DomainTerm[];
  /** Right column: parent-facing observations. Not paired with terms.
   *  May contain <strong>, so rendered with set:html. */
  observations: string[];
  assoc?: { lead: string; conditions: AssocCondition[] };
  /** Closing note in a tinted box. May contain <strong>. */
  note?: string;
  /** Accent tint for this domain. One per encadré. */
  tint?: 'lavender' | 'mint' | 'blue';
}

const {
  title, icon, intro, headings, terms, observations, assoc, note,
  tint = 'lavender',
} = Astro.props;
---

<article class={`encadre tint-${tint}`}>
  <h3>
    {icon && <span class="ico" aria-hidden="true">{icon}</span>}
    {title}
  </h3>
  <p class="encadre-intro" set:html={intro} />

  <div class="intake">
    <div class="col-head" aria-hidden="true">
      <span>{headings[0]}</span>
      <span>{headings[1]}</span>
    </div>
    <div class="two-col">
      <div class="tcol">
        <p class="mh">{headings[0]}</p>
        {terms.map(t => (
          <div class="tItem">
            {t.term}
            {t.sub && <small>{t.sub}</small>}
          </div>
        ))}
      </div>
      <div class="ocol">
        <p class="mh">{headings[1]}</p>
        <ul class="olist">
          {observations.map(o => <li set:html={o} />)}
        </ul>
      </div>
    </div>
  </div>

  {assoc && (
    <div class="assoc">
      <p class="assoc-lead">{assoc.lead}</p>
      <div class="assoc-grid">
        {assoc.conditions.map(c => (
          <div class={c.featured ? 'cond featured' : 'cond'}>
            <h4>{c.title}</h4>
            {c.desc && <p>{c.desc}</p>}
          </div>
        ))}
      </div>
    </div>
  )}

  {note && <p class="transversal" set:html={note} />}
</article>

<style>
  .encadre {
    --deep: #2C2C2C;
    --tint: var(--color-tint-lavender);
    --tint-soft: #EDE7F5;
    --tint-soft: color-mix(in srgb, var(--color-tint-lavender) 55%, white);
    --tint-edge: #A99BC4;
    --tint-edge: color-mix(in srgb, var(--color-tint-lavender) 70%, var(--deep) 18%);

    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 2.4rem 2.5rem 2.1rem;
    margin-bottom: 1.6rem;
    box-shadow: 0 1px 2px rgba(44,44,44,0.04), 0 18px 40px -28px rgba(44,44,44,0.20);
  }

  .encadre.tint-mint {
    --tint: var(--color-tint-mint);
    --tint-soft: #E9F4EE;
    --tint-soft: color-mix(in srgb, var(--color-tint-mint) 55%, white);
    --tint-edge: #9DC7B0;
    --tint-edge: color-mix(in srgb, var(--color-tint-mint) 70%, var(--deep) 18%);
  }

  .encadre.tint-blue {
    --tint: var(--color-tint-blue);
    --tint-soft: #E6EEF5;
    --tint-soft: color-mix(in srgb, var(--color-tint-blue) 55%, white);
    --tint-edge: #8FAEC6;
    --tint-edge: color-mix(in srgb, var(--color-tint-blue) 70%, var(--deep) 18%);
  }

  .encadre h3 {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 500;
    color: var(--deep);
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .encadre h3 .ico { font-size: 1.5rem; line-height: 1; }

  .encadre-intro {
    font-size: 1rem;
    color: var(--color-text-light);
    margin: 0 0 1.5rem;
    max-width: 64ch;
    line-height: 1.6;
  }
  .encadre-intro :global(strong) { font-weight: 600; color: var(--color-text); }

  /* ── Intake: shared header, two independent columns ── */
  .intake {
    border-top: 1px solid var(--color-border);
    padding-top: 1.4rem;
  }
  .col-head {
    display: grid;
    grid-template-columns: 0.95fr 1.1fr;
    gap: 2.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .col-head span {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--deep);
  }
  .two-col {
    display: grid;
    grid-template-columns: 0.95fr 1.1fr;
    gap: 2.75rem;
    padding-top: 0.25rem;
  }
  .mh {
    display: none;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--deep);
    margin: 0 0 0.75rem;
  }

  .tItem {
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--deep);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.45;
  }
  .tItem:last-child { border-bottom: none; }
  .tItem small {
    display: block;
    font-weight: 500;
    color: var(--color-text-light);
    font-size: 0.82rem;
    margin-top: 2px;
  }

  .ocol { padding-top: 0.5rem; }
  ul.olist { list-style: none; margin: 0; padding: 0; }
  ul.olist li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-light);
    font-size: 0.97rem;
  }
  ul.olist li :global(strong) { color: var(--color-text); font-weight: 600; }
  ul.olist li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tint-edge);
  }

  /* ── Associated conditions ── */
  .assoc { margin-top: 1.75rem; }
  .assoc-lead {
    font-size: 0.97rem;
    color: var(--color-text);
    margin: 0 0 0.4rem;
    max-width: 62ch;
    line-height: 1.6;
  }
  .assoc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(168px, 1fr));
    gap: 0.75rem;
    margin-top: 0.875rem;
  }
  .cond {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.95rem 1rem;
  }
  /* The featured condition is always lavender, whatever the domain tint,
     so the most common condition reads the same across every encadré. */
  .cond.featured {
    background: #EDE7F5;
    background: color-mix(in srgb, var(--color-tint-lavender) 55%, white);
    border-color: var(--color-tint-lavender);
    border-left: 3px solid #A99BC4;
    border-left: 3px solid color-mix(in srgb, var(--color-tint-lavender) 70%, var(--deep) 18%);
  }
  .cond h4 {
    margin: 0 0 0.3rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--deep);
  }
  .cond p {
    margin: 0;
    font-size: 0.84rem;
    color: var(--color-text-light);
    line-height: 1.5;
  }

  /* ── Closing note ── */
  .transversal {
    margin-top: 1.75rem;
    background: var(--tint-soft);
    border: 1px solid var(--tint);
    border-radius: 12px;
    padding: 1rem 1.1rem;
    font-size: 0.94rem;
    color: var(--deep);
    line-height: 1.6;
  }
  .transversal :global(strong) { font-weight: 600; }

  @media (max-width: 600px) {
    .encadre { padding: 1.75rem 1.4rem; }
    .col-head { display: none; }
    .two-col { grid-template-columns: 1fr; gap: 1.6rem; }
    .mh { display: block; }
    .ocol { padding-top: 0; }
    .assoc-grid { grid-template-columns: 1fr; }
  }
</style>

---
/**
 * "Encadré" card for the Domaines d'intervention section.
 *
 * Layout follows Ari's mockup: a two-column table pairing the clinical
 * label with a plain-language question a parent would recognise, then
 * optional associated-condition chips and a closing note.
 *
 * `plain` and `note` accept inline <strong> tags, so they are rendered
 * with set:html. Only ever pass hard-coded copy from this repo.
 */
export interface DomainRow {
  /** Clinical name, e.g. "Trouble développemental du langage". */
  term: string;
  /** Small print under the term, e.g. an acronym. */
  sub?: string;
  /** Parent-facing rephrasing. May contain <strong>. */
  plain: string;
}

export interface Props {
  title: string;
  intro: string;
  /** Column headings above the rows. */
  headings: [string, string];
  rows: DomainRow[];
  /** Optional block of associated conditions. */
  assoc?: { lead: string; chips: string[] };
  /** Optional closing note in a tinted box. May contain <strong>. */
  note?: string;
}

const { title, intro, headings, rows, assoc, note } = Astro.props;
---

<article class="encadre">
  <h3>{title}</h3>
  <p class="encadre-intro">{intro}</p>

  <dl class="rows">
    <dt class="col-head" aria-hidden="true">{headings[0]}</dt>
    <dd class="col-head" aria-hidden="true">{headings[1]}</dd>

    {rows.map(row => (
      <>
        <dt class="term">
          {row.term}
          {row.sub && <small>{row.sub}</small>}
        </dt>
        <dd class="plain" set:html={row.plain} />
      </>
    ))}
  </dl>

  {assoc && (
    <div class="assoc">
      <p class="assoc-lead">{assoc.lead}</p>
      <ul class="chips">
        {assoc.chips.map(chip => <li class="chip">{chip}</li>)}
      </ul>
    </div>
  )}

  {note && <p class="note" set:html={note} />}
</article>

<style>
  .encadre {
    --deep: #2C2C2C;

    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 2.4rem 2.5rem 2.1rem;
    box-shadow: 0 1px 2px rgba(44,44,44,0.04), 0 18px 40px -28px rgba(44,44,44,0.20);
  }

  .encadre h3 {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 500;
    color: var(--deep);
    margin: 0 0 0.5rem;
  }

  .encadre-intro {
    font-size: 1rem;
    color: var(--color-text-light);
    margin: 0 0 1.6rem;
    max-width: 52ch;
    line-height: 1.6;
  }

  /* ── Rows ── */
  .rows {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    margin: 0;
  }

  .rows dt,
  .rows dd {
    margin: 0;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .rows dt { padding-right: 1.5rem; }

  .col-head {
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    font-weight: 600;
    padding-top: 0 !important;
    padding-bottom: 0.6rem !important;
  }

  .term {
    font-weight: 600;
    color: var(--deep);
    font-size: 1rem;
    line-height: 1.4;
  }
  .term small {
    display: block;
    font-weight: 500;
    color: var(--color-text-light);
    font-size: 0.82rem;
    margin-top: 0.15rem;
  }

  .plain {
    color: var(--color-text-light);
    font-size: 0.97rem;
    line-height: 1.6;
  }
  .plain :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  /* ── Associated conditions ── */
  .assoc { margin-top: 1.6rem; }
  .assoc-lead {
    font-size: 0.97rem;
    color: var(--color-text);
    margin: 0 0 0.9rem;
    max-width: 56ch;
    line-height: 1.6;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .chip {
    background: white;
    border: 1px solid var(--color-border);
    color: var(--deep);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
  }

  /* ── Closing note ── */
  .note {
    margin: 1.6rem 0 0;
    background: #EDE7F5;
    background: color-mix(in srgb, var(--color-tint-lavender) 55%, white);
    border: 1px solid #D2C7E5;
    border: 1px solid var(--color-tint-lavender);
    border-radius: 12px;
    padding: 1rem 1.1rem;
    font-size: 0.94rem;
    color: var(--deep);
    line-height: 1.6;
  }
  .note :global(strong) { font-weight: 600; }

  @media (max-width: 700px) {
    .encadre { padding: 1.75rem 1.4rem; }
    .rows { grid-template-columns: 1fr; }
    .col-head { display: none; }
    .rows dt {
      padding: 0.9rem 0 0.15rem;
      border-bottom: none;
    }
    .rows dd { padding: 0 0 0.9rem; }
    .plain { font-size: 0.93rem; }
  }
</style>

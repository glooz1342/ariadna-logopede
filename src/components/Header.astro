---
import { LANGS, LANG_META, ROUTES, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
  /** Path to the same page in each language (falls back to that language's home). */
  switchHrefs?: Record<Lang, string>;
}
const { lang, switchHrefs } = Astro.props as Props;

/** A sub-item in a dropdown. No href = not clickable yet (e.g. "coming soon"). */
type NavChild = { label: string; href?: string; note?: string };
type NavItem = { label: string; href: string; children?: NavChild[] };

const nav: Record<Lang, NavItem[]> = {
  fr: [
    { label: 'Accueil', href: '/fr' },
    { label: 'À propos', href: '/fr/apropos' },
    {
      label: 'Consultation',
      href: '/fr/#consultations',
      children: [
        { label: 'En cabinet', href: '/fr/consultation/en-cabinet' },
        { label: 'À domicile', href: '/fr/consultation/a-domicile' },
        { label: 'En ligne', note: 'à venir' },
      ],
    },
    { label: 'Actualités', href: '/fr/actualites' },
    { label: 'Contact', href: '/fr/contact' },
  ],
  en: [
    { label: 'Home', href: '/en' },
    { label: 'About', href: '/en/about' },
    {
      label: 'Consultation',
      href: '/en/#areas-of-practice',
      children: [
        { label: 'At the practice', href: '/en/consultation/at-the-practice' },
        { label: 'At home', href: '/en/consultation/at-home' },
        { label: 'Online', note: 'coming soon' },
      ],
    },
    { label: 'News', href: '/en/news' },
    { label: 'Contact', href: '/en/contact' },
  ],
  es: [
    { label: 'Inicio', href: ROUTES.home.es },
    { label: 'Sobre mí', href: ROUTES.about.es },
    {
      label: 'Consulta',
      href: '/es/#consultas',
      children: [
        { label: 'En el centro', href: ROUTES.practice.es },
        { label: 'A domicilio', href: ROUTES.homeVisit.es },
        { label: 'En línea', note: 'próximamente' },
      ],
    },
    { label: 'Noticias', href: ROUTES.news.es },
    { label: 'Contacto', href: ROUTES.contact.es },
  ],
  it: [
    { label: 'Home', href: ROUTES.home.it },
    { label: 'Chi sono', href: ROUTES.about.it },
    {
      label: 'Consulenza',
      href: '/it/#consulenze',
      children: [
        { label: 'In studio', href: ROUTES.practice.it },
        { label: 'A domicilio', href: ROUTES.homeVisit.it },
        { label: 'Online', note: 'prossimamente' },
      ],
    },
    { label: 'Notizie', href: ROUTES.news.it },
    { label: 'Contatti', href: ROUTES.contact.it },
  ],
};

const role: Record<Lang, string> = {
  fr: 'Logopède',
  en: 'Speech Therapist',
  es: 'Logopeda',
  it: 'Logopedista',
};

const links = nav[lang];
const langHref = (l: Lang) => switchHrefs?.[l] ?? ROUTES.home[l];

/**
 * Internal paths are emitted with a trailing slash so they match the canonical
 * URL Astro builds (/fr/contact/). Linking to /fr/contact costs a redirect and
 * splits the URL in Search Console. Anchors and files are left alone.
 */
const withSlash = (p: string) =>
  p.startsWith('/') && !p.includes('#') && !p.includes('.') && !p.endsWith('/')
    ? `${p}/`
    : p;

/**
 * Nothing in the nav told a visitor which page they were on.
 *
 * Two distinct states, deliberately:
 *  - `aria-current="page"` only on an exact match, so a screen reader
 *    announces exactly one current page.
 *  - `.is-active` on an ancestor section too — an article under
 *    /fr/actualites/ highlights "Actualités" visually, but that link is not
 *    the page you are on, so it gets no aria-current.
 *
 * The Consultation parent points at a homepage anchor rather than a page of
 * its own, so it never carries aria-current; it only lights up when one of
 * its children is active.
 */
const current = withSlash(Astro.url.pathname);
const langRoot = withSlash(`/${lang}`);

const isCurrent = (href?: string) => !!href && withSlash(href) === current;

const isSection = (href?: string) => {
  if (!href) return false;
  const h = withSlash(href);
  // The language root prefixes every page, so it only ever matches exactly.
  return h !== langRoot && !h.includes('#') && current.startsWith(h);
};

const hasActiveChild = (children?: NavChild[]) =>
  (children ?? []).some(c => isCurrent(c.href) || isSection(c.href));
---

<header>
  <div class="header-inner">
    <a href={`/${lang}/`} class="logo">
      <img src="/logo-mark.svg" alt="" width="34" height="37" class="logo-mark" />
      <span class="logo-text">
        <span class="logo-name">Ariadna Balsells</span>
        <span class="logo-role">{role[lang]}</span>
      </span>
    </a>

    <nav id="main-nav">
      {links.map(link => link.children ? (
        <div class="nav-item has-dropdown">
          <a
            href={withSlash(link.href)}
            class:list={['nav-link', 'nav-parent', { 'is-active': hasActiveChild(link.children) }]}
            aria-haspopup="true"
          >
            {link.label}
            <svg class="caret" width="10" height="10" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="dropdown">
            <div class="dropdown-panel">
              {link.children.map(child => child.href ? (
                <a
                  href={withSlash(child.href)}
                  class:list={['dropdown-link', { 'is-active': isCurrent(child.href) }]}
                  aria-current={isCurrent(child.href) ? 'page' : undefined}
                >{child.label}</a>
              ) : (
                <span class="dropdown-link is-soon" aria-disabled="true">
                  {child.label}<em class="soon-badge">{child.note}</em>
                </span>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a
          href={withSlash(link.href)}
          class:list={['nav-link', { 'is-active': isCurrent(link.href) || isSection(link.href) }]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
        >{link.label}</a>
      ))}
      <div class="lang-switch mobile-lang" role="group" aria-label={LANG_META[lang].switcherLabel}>
        {LANGS.map(l => (
          <a href={withSlash(langHref(l))} lang={l} hreflang={l}
            aria-label={LANG_META[l].name}
            aria-current={l === lang ? 'true' : undefined}
            class:list={['lang-option', { 'is-current': l === lang }]}>{l.toUpperCase()}</a>
        ))}
      </div>
    </nav>

    <div class="header-right">
      <div class="lang-switch desktop-lang" role="group" aria-label={LANG_META[lang].switcherLabel}>
        {LANGS.map(l => (
          <a href={withSlash(langHref(l))} lang={l} hreflang={l}
            aria-label={LANG_META[l].name}
            aria-current={l === lang ? 'true' : undefined}
            class:list={['lang-option', { 'is-current': l === lang }]}>{l.toUpperCase()}</a>
        ))}
      </div>
      <button class="hamburger" id="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="main-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const nav = document.getElementById('main-nav');

  function closeMenu() {
    nav?.classList.remove('open');
    hamburger?.classList.remove('open');
    hamburger?.setAttribute('aria-expanded', 'false');
  }

  hamburger?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
    hamburger.classList.toggle('open');
  });

  // Close the mobile menu when a link is tapped (matters for same-page
  // anchor links like /fr/#consultations, which don't trigger a reload)
  nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>

<style>
  /* No white bar: the header sits on the page ground. It stays sticky, so
     it is a frosted panel rather than fully transparent — invisible against
     the ground at the top of the page, still legible once cards and text
     scroll underneath it. */
  header {
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  @supports not (backdrop-filter: blur(12px)) {
    header { background: var(--color-bg); }
  }
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo { display: flex; align-items: center; gap: 0.65rem; line-height: 1.2; }
  .logo-mark { width: 34px; height: auto; flex-shrink: 0; display: block; }
  .logo-text { display: flex; flex-direction: column; }
  .logo-name {
    white-space: nowrap;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
  }
  .logo-role {
    font-size: 0.72rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .header-right { display: flex; align-items: center; gap: 1rem; }

  /* Nav */
  nav { display: flex; gap: 2rem; align-items: center; }
  .nav-link {
    white-space: nowrap;
    font-size: 0.9rem;
    color: var(--color-text-light);
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  /* The active state must not rely on colour alone: the underline carries it
     for anyone who cannot distinguish the two greys. */
  .nav-link.is-active {
    color: var(--color-text);
    border-bottom-color: var(--color-purple);
  }
  .dropdown-link.is-active {
    color: var(--color-purple-dark);
    font-weight: 500;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-accent);
    border-bottom-color: var(--color-purple);
  }

  /* ── Dropdown (desktop) ── */
  .nav-item { position: relative; }
  .nav-parent {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .caret { transition: transform 0.2s; flex-shrink: 0; }
  .has-dropdown:hover .caret,
  .has-dropdown:focus-within .caret { transform: rotate(180deg); }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    /* transparent bridge so the menu survives the gap under the label */
    padding-top: 14px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, visibility 0.18s;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
  }
  .dropdown-panel {
    min-width: 190px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    padding: 0.4rem;
    display: flex;
    flex-direction: column;
  }
  .dropdown-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
    color: var(--color-text-light);
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  a.dropdown-link:hover {
    background: var(--color-bg);
    color: var(--color-accent);
  }
  .is-soon { color: #A6A6A6; cursor: default; }
  .soon-badge {
    font-style: normal;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    background: var(--color-tint-mint);
    border-radius: 99px;
    padding: 1px 8px;
    white-space: nowrap;
  }

  /* Lang switch: four codes in one outlined group. The current language is
     marked by weight and an underline, not colour alone. */
  .lang-switch {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.15rem;
  }
  .lang-option {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    padding: 0.2rem 0.45rem;
    border-radius: 3px;
    border-bottom: 1.5px solid transparent;
    transition: color 0.2s, background 0.2s;
  }
  .lang-option:hover { color: var(--color-accent); background: var(--color-surface); }
  .lang-option.is-current {
    color: var(--color-text);
    font-weight: 700;
    border-bottom-color: var(--color-purple);
    border-radius: 3px 3px 0 0;
  }
  .mobile-lang { display: none; }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: all 0.3s;
    transform-origin: center;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Four languages in the switcher leave less room for the nav. Measured
     need with the tighter gap: ~830px for French (the longest labels), so
     the hamburger takes over below 860px rather than the old 768px. */
  @media (max-width: 1000px) {
    nav { gap: 1.25rem; }
    .header-inner { padding: 0 1.5rem; }
  }

  /* ── Mobile ── */
  @media (max-width: 860px) {
    .hamburger { display: flex; }
    .desktop-lang { display: none; }
    .mobile-lang { display: flex; border: none; padding: 0.6rem 0 0; gap: 0.5rem; }
    .mobile-lang .lang-option { font-size: 0.9rem; padding: 0.45rem 0.6rem; }

    nav {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      background: var(--color-bg);
      flex-direction: column;
      align-items: flex-start;
      padding: 0.5rem 2rem 1rem;
      border-bottom: 1px solid var(--color-border);
      gap: 0;
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
      max-height: calc(100vh - 72px);
      overflow-y: auto;
    }
    nav.open { display: flex; }
    .nav-link {
      width: 100%;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 1rem;
    }

    /* No hover on touch: sub-items are simply always visible, indented. */
    .nav-item {
      width: 100%;
      border-bottom: 1px solid var(--color-border);
    }
    .caret { display: none; }
    .nav-parent {
      border-bottom: none;
      padding-bottom: 0.4rem;
    }
    .dropdown {
      position: static;
      transform: none;
      padding-top: 0;
      opacity: 1;
      visibility: visible;
    }
    .dropdown-panel {
      border: none;
      box-shadow: none;
      background: transparent;
      padding: 0 0 0.35rem;
      min-width: 0;
    }
    .dropdown-link {
      justify-content: flex-start;
      padding: 0.5rem 0 0.5rem 1rem;
      border-left: 2px solid var(--color-border);
      border-radius: 0;
      font-size: 0.95rem;
    }
  }
</style>

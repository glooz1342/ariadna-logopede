---
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props as Props;

const nav = {
  fr: [
    { label: 'Accueil', href: '/fr' },
    { label: 'À propos', href: '/fr/apropos' },
    {
      label: 'Consultations',
      dropdown: [
        { label: 'Langage oral', href: '/fr/prises-en-charge/langage-oral' },
        { label: 'Troubles alimentaires pédiatriques', href: '/fr/prises-en-charge/troubles-alimentaires-pediatriques' },
        { label: 'Dyscalculie', href: '/fr/prises-en-charge/dyscalculie' },
        { label: 'CAA', href: '/fr/prises-en-charge/caa' },
      ]
    },
    { label: 'Galerie', href: '/fr/galerie' },
    { label: 'Contact', href: '/fr/contact' },
  ],
  en: [
    { label: 'Home', href: '/en' },
    { label: 'About', href: '/en/about' },
    {
      label: 'Areas of practice',
      dropdown: [
        { label: 'Oral language', href: '/en/areas-of-practice/oral-language' },
        { label: 'Pediatric feeding disorders', href: '/en/areas-of-practice/pediatric-feeding-disorders' },
        { label: 'Dyscalculia', href: '/en/areas-of-practice/dyscalculia' },
        { label: 'AAC', href: '/en/areas-of-practice/aac' },
      ]
    },
    { label: 'Gallery', href: '/en/gallery' },
    { label: 'Contact', href: '/en/contact' },
  ],
};

const links = nav[lang];
const otherLang = lang === 'fr' ? 'en' : 'fr';
---

<header>
  <div class="header-inner">
    <a href={`/${lang}`} class="logo">
      <span class="logo-name">Ariadna Balsells</span>
      <span class="logo-role">{lang === 'fr' ? 'Logopède' : 'Speech Therapist'}</span>
    </a>

    <nav id="main-nav">
      {links.map(link => (
        link.dropdown ? (
          <div class="dropdown-wrapper">
            <button class="nav-link dropdown-toggle" aria-expanded="false">
              {link.label}
              <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="dropdown-menu">
              {link.dropdown.map(item => (
                <a href={item.href} class="dropdown-item">{item.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} class="nav-link">{link.label}</a>
        )
      ))}
      <a href={`/${otherLang}`} class="lang-switch mobile-lang">{otherLang.toUpperCase()}</a>
    </nav>

    <div class="header-right">
      <a href={`/${otherLang}`} class="lang-switch desktop-lang">{otherLang.toUpperCase()}</a>
      <button class="hamburger" id="hamburger" aria-label="Menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Hamburger toggle
  const hamburger = document.getElementById('hamburger');
  const nav = document.getElementById('main-nav');

  hamburger?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
    hamburger.classList.toggle('open');
  });

  // Dropdown toggles (handles both desktop hover-intent click and mobile tap)
  document.querySelectorAll('.dropdown-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wrapper = btn.closest('.dropdown-wrapper');
      const isOpen = wrapper?.classList.toggle('active');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', () => {
    document.querySelectorAll('.dropdown-wrapper.active').forEach(w => {
      w.classList.remove('active');
      w.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  header {
    background: white;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo { display: flex; flex-direction: column; line-height: 1.2; }
  .logo-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
  }
  .logo-role {
    font-size: 0.72rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .header-right { display: flex; align-items: center; gap: 1rem; }

  /* Nav */
  nav { display: flex; gap: 2rem; align-items: center; }
  .nav-link {
    font-size: 0.9rem;
    color: var(--color-text-light);
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--color-accent); }

  /* Dropdown wrapper */
  .dropdown-wrapper { position: relative; }

  .dropdown-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: inherit;
  }

  .chevron {
    transition: transform 0.2s;
    color: var(--color-text-light);
    flex-shrink: 0;
  }
  .dropdown-wrapper.active .chevron { transform: rotate(180deg); }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 1rem);
    left: 50%;
    transform: translateX(-50%);
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    min-width: 260px;
    padding: 0.5rem 0;
    z-index: 200;
  }
  .dropdown-wrapper.active .dropdown-menu { display: block; }

  .dropdown-item {
    display: block;
    padding: 0.65rem 1.25rem;
    font-size: 0.88rem;
    color: var(--color-text-light);
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .dropdown-item:hover {
    background: var(--color-bg);
    color: var(--color-accent);
  }

  /* Lang switch */
  .lang-switch {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-light);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    transition: all 0.2s;
    letter-spacing: 0.05em;
  }
  .lang-switch:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .mobile-lang { display: none; }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: all 0.3s;
    transform-origin: center;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hamburger { display: flex; }
    .desktop-lang { display: none; }
    .mobile-lang { display: block; border: none; padding: 0.75rem 0; }

    nav {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      background: white;
      flex-direction: column;
      align-items: flex-start;
      padding: 0.5rem 2rem 1rem;
      border-bottom: 1px solid var(--color-border);
      gap: 0;
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    }
    nav.open { display: flex; }
    .nav-link {
      width: 100%;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 1rem;
    }

    /* Mobile dropdown */
    .dropdown-wrapper { width: 100%; }
    .dropdown-toggle {
      width: 100%;
      justify-content: space-between;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 1rem;
    }
    .dropdown-menu {
      position: static;
      transform: none;
      box-shadow: none;
      border: none;
      border-radius: 0;
      padding: 0;
      min-width: unset;
    }
    .dropdown-item {
      padding: 0.6rem 1rem;
      font-size: 0.95rem;
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>